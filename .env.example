# Beter Hack Club Auth
HACKCLUB_CLIENT_ID=from_hca
HACKCLUB_CLIENT_SECRET=from_hca
BETTER_AUTH_SECRET=randomly_generated_by_ba
BETTER_AUTH_URL=http://localhost:4000

# Indigest (a delegating key scoped to the Slack column channels)
INDIGEST_API_KEY=ind_from_indigest
# INDIGEST_API_URL=https://indigest.matmanna.dev

# Channel whose article threads hold comments (#news in production). Leave
# unset to turn comments off.
# COMMENTS_CHANNEL_ID=C0123456789
# Hold back comments over 2 a day and 3 in all per account (see
# COMMENT_LIMITS in src/lib/comments.ts). Off unless set to 1 or true.
# COMMENT_LIMITS_ENABLED=1

# Optional legacy shared token for protected RSS items
RSS_ACCESS_TOKEN=something_really_long_goes_here

