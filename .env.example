# Beter Hack Club Auth
HACKCLUB_CLIENT_ID=from_hca
HACKCLUB_CLIENT_SECRET=from_hca
BETTER_AUTH_SECRET=randomly_generated_by_ba
BETTER_AUTH_URL=http://localhost:4000

# Indigest (a delegating key scoped to the Slack column channels)
INDIGEST_API_KEY=ind_from_indigest
# INDIGEST_API_URL=https://indigest.matmanna.dev

# Optional legacy shared token for protected RSS items
RSS_ACCESS_TOKEN=something_really_long_goes_here


# EmDash CMS (only read when the site is built with CMS=emdash)
# EMDASH_ENCRYPTION_KEY=from `bunx emdash secrets generate`
# EMDASH_SITE_URL=http://localhost:4000
# EMDASH_HACKCLUB_ADMINS=U0123ABCDEF,someone@example.com
# Slack messages from the newsroom: a bot token with chat:write, and the ID of
# the channel that hears about new drafts and their review
# SLACK_BOT_TOKEN=xoxb-from-your-slack-app
# NEWSROOM_SLACK_CHANNEL=C0123ABCDEF
