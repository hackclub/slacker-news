---
import AbacusCounter from "../components/AbacusCounter.astro";
import SiteFooter from "../components/SiteFooter.astro";
import NewsTicker from "../components/NewsTicker.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  siteTitle: string;
  siteDescription: string;
  canonicalPath?: string;
  openGraphType?: "website" | "article";
  openGraphImage?: string;
  openGraphImageAlt?: string;
  openGraphLocale?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
}

import "../styles/main.scss";
import "../styles/redesign-poll.scss";
import { POLL_PATH, POLL_QUESTIONS, POLL_STORAGE_KEY } from "../lib/redesign-poll";

const {
  title,
  description,
  siteTitle,
  siteDescription,
  canonicalPath,
  openGraphType = "website",
  openGraphImage,
  openGraphImageAlt,
  openGraphLocale = "en_US",
  articlePublishedTime,
  articleModifiedTime
} = Astro.props;
const pageTitle = title && title !== siteTitle ? `${title} | ${siteTitle}` : siteTitle;
const pageDescription = description ?? siteDescription;
const authReturnTo = `${Astro.url.pathname}${Astro.url.search}`;
const isAuthenticated = Boolean(Astro.locals.user);

function toAbsoluteURL(input: string): string {
  return new URL(input, Astro.site ?? Astro.url).toString();
}

const canonicalURL = toAbsoluteURL(canonicalPath ?? Astro.url.pathname);
const socialImageURL = toAbsoluteURL(openGraphImage ?? "https://cdn.hackclub.com/019dbae9-5242-745b-acd2-3476ab3c52a3/og-default.png");
const socialImageAlt = openGraphImageAlt ?? `${siteTitle} social preview`;
const pollOldClasses = POLL_QUESTIONS.map(({ key, oldClass }) => ({ key, oldClass }));
---

<!doctype html>
<html lang="en" class="no-js" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? siteTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <meta property="og:title" content={title ?? siteTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:type" content={openGraphType} />
    <meta property="og:locale" content={openGraphLocale} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content={socialImageAlt} />

    <ClientRouter />
    <script>
      import {
        bylineTransitionName,
        dateTransitionName,
        excerptTransitionName,
        readingTimeTransitionName,
        titleTransitionName,
      } from "../lib/transitions";
      import { themeWipe } from "../lib/theme-wipe";
      import { initStoryPrefetch } from "../lib/story-prefetch";
      import type {
        TransitionBeforePreparationEvent,
        TransitionBeforeSwapEvent,
      } from "astro:transitions/client";

      (window as unknown as { __themeWipe?: typeof themeWipe }).__themeWipe = themeWipe;

      // Module scripts run once, and the listeners sit on the document, so
      // they keep working across client-side navigations.
      initStoryPrefetch();

      // Carry the title, byline, read time and excerpt tied to this
      // navigation: those for the page being opened and for the page being
      // left. Everything else stays
      // unnamed, so the rest of the page swaps without animating.
      let paths: string[] = [];
      // Listing to listing (homepage, search, archives): the titles of the
      // stories on screen, which carry to wherever the same stories sit on
      // the next page.
      let listingTitles: string[] = [];
      const cardSelector = ".search-result, .story-block, .opinion-item, .front-lead, .slack-column-block";

      // An element on the page being left only carries if some of it is on
      // screen. One scrolled out of view would otherwise fly in from off the
      // edge; left unnamed, its counterpart just appears in place.
      function onScreen(element: Element): boolean {
        const box = element.getBoundingClientRect();
        return box.bottom > 0 && box.top < innerHeight && box.right > 0 && box.left < innerWidth;
      }

      function carry(element: Element | null, name: string, kind: string) {
        if (!(element instanceof HTMLElement)) return;
        if (element.ownerDocument === document && document.contains(element) && !onScreen(element)) return;
        element.style.viewTransitionName = name;
        element.style.setProperty("view-transition-class", kind);
        element.dataset.vtCarried = "";
      }

      // Bumped on every navigation, so a transition that finishes late (it
      // was cut short by another click) doesn't clear the next one's names.
      let generation = 0;

      function clearCarried(root: Document) {
        root.querySelectorAll<HTMLElement>("[data-vt-carried]").forEach((element) => {
          element.style.viewTransitionName = "";
          element.style.removeProperty("view-transition-class");
          delete element.dataset.vtCarried;
        });
      }

      // The text of the excerpt the reader clicked, by excerpt key, read from
      // the page being left so the article side can find the same passage.
      let excerptTexts = new Map<string, string>();

      // Text reduced to lowercase letters, digits and single spaces, so a
      // homepage excerpt and the article match however each was formatted:
      // curly or straight quotes, Slack's *bold* and _italic_ markers,
      // trailing ellipses.
      function normalise(text: string): string {
        return text
          .toLowerCase()
          .replace(/[^\p{L}\p{N}\s]+/gu, "")
          .replace(/\s+/g, " ")
          .trim();
      }

      function openingWords(text: string): string {
        return text.split(" ").slice(0, 5).join(" ");
      }

      // The run of paragraphs and list items in an article body that the
      // excerpt showed, matched by their opening words. Anything before the
      // first match (an italic note, say) is skipped; the run ends at the
      // first full-length block after it that the excerpt didn't include.
      function excerptBlocks(body: Element, excerptText: string): HTMLElement[] {
        if (!excerptText) return [];
        const excerptOpening = openingWords(excerptText);
        const blocks = [...body.querySelectorAll<HTMLElement>("p, li, .slack-paragraph")].filter(
          (block) => !block.querySelector("p, li, .slack-paragraph"),
        );
        // A body with no paragraphs at all: carry the whole of it when it
        // opens the way the excerpt does.
        if (blocks.length === 0) {
          const text = normalise(body.textContent ?? "");
          return text && (text.includes(excerptOpening) || excerptText.includes(openingWords(text)))
            ? [body as HTMLElement]
            : [];
        }
        const found: HTMLElement[] = [];
        for (const block of blocks) {
          const text = normalise(block.textContent ?? "");
          if (!text) continue;
          const shown = excerptText.includes(openingWords(text)) || text.includes(excerptOpening);
          // The homepage leaves out short lines ("Here are the requirements:"),
          // so they don't end the run.
          const short = text.split(" ").length < 6 || text.length < 35;
          if (shown) found.push(block);
          else if (found.length > 0 && !short) break;
          if (found.length >= 12) break;
        }
        return found;
      }

      // The part of an excerpt the reader can actually see. A card can hold a
      // whole Slack message and clip it to a few lines; only the words above
      // the clip count, or the article would carry paragraphs the card never
      // showed.
      function shownText(element: Element): string {
        let bottom = element.getBoundingClientRect().bottom;
        for (let ancestor = element.parentElement; ancestor && ancestor !== document.body; ancestor = ancestor.parentElement) {
          if (getComputedStyle(ancestor).overflowY !== "visible") {
            bottom = Math.min(bottom, ancestor.getBoundingClientRect().bottom);
          }
        }
        let text = "";
        const range = document.createRange();
        const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT);
        while (walker.nextNode()) {
          const node = walker.currentNode as Text;
          for (const word of node.data.matchAll(/\S+/g)) {
            range.setStart(node, word.index);
            range.setEnd(node, word.index + word[0].length);
            const box = range.getClientRects()[0];
            // Clipped words sit below the clip (line-clamp, a fixed height).
            if (box && box.top + box.height / 2 > bottom) return text + node.data.slice(0, word.index);
          }
          text += node.data;
        }
        return text;
      }

      function nameCarried(root: Document) {
        clearCarried(root);
        for (const title of listingTitles) {
          const story = title.replace(/^title-/, "");
          carry(root.querySelector(`[data-vt-title="${CSS.escape(title)}"]`), title, "carried");
          for (const kind of ["byline", "date", "reading-time"]) {
            const name = `${kind}-${story}`;
            carry(root.querySelector(`[data-vt-${kind}="${CSS.escape(name)}"]`), name, "carried");
          }
          // Card excerpts differ in length from page to page, so they move
          // like the article excerpts do (see planExcerptFlights).
          const excerpt = `excerpt-${story}`;
          carry(root.querySelector(`[data-vt-excerpt="${CSS.escape(excerpt)}"]`), excerpt, "carried-excerpt");
          // The card itself (its box, and anything not carried on its own)
          // comes part of the way from where the story was.
          carry(
            root.querySelector(`[data-vt-title="${CSS.escape(title)}"]`)?.closest(cardSelector) ?? null,
            `card-${story}`,
            "carried-card",
          );
        }
        for (const path of new Set(paths)) {
          const title = titleTransitionName(path);
          const excerpt = excerptTransitionName(path);
          carry(root.querySelector(`[data-vt-title="${CSS.escape(title)}"]`), title, "carried");
          const byline = bylineTransitionName(path);
          carry(root.querySelector(`[data-vt-byline="${CSS.escape(byline)}"]`), byline, "carried");
          const date = dateTransitionName(path);
          carry(root.querySelector(`[data-vt-date="${CSS.escape(date)}"]`), date, "carried");
          const readingTime = readingTimeTransitionName(path);
          carry(
            root.querySelector(`[data-vt-reading-time="${CSS.escape(readingTime)}"]`),
            readingTime,
            "carried",
          );
          // On a card it's the excerpt. On the article it's just the
          // paragraphs that excerpt showed; the rest of the body swaps in with
          // the page. They rise into place as the title lands.
          const card = root.querySelector(`[data-vt-excerpt="${CSS.escape(excerpt)}"]`);
          if (card) {
            carry(card, excerpt, "carried-excerpt");
          } else {
            const body = root.querySelector(`[data-vt-body="${CSS.escape(excerpt)}"]`);
            if (body) {
              excerptBlocks(body, excerptTexts.get(excerpt) ?? "").forEach((block, index) =>
                carry(block, `${excerpt}-${index}`, "carried-excerpt"),
              );
            }
          }
        }
      }

      document.addEventListener("astro:before-preparation", (event) => {
        generation += 1;
        const { from, to } = event as TransitionBeforePreparationEvent;
        paths = [to.pathname, from.pathname];
        // Not opening or leaving an article: carry the stories on screen.
        const articleNavigation = paths.some((path) =>
          document.querySelector(`[data-vt-title="${CSS.escape(titleTransitionName(path))}"]`),
        );
        // Leaving the homepage for search swaps without carrying anything;
        // coming back from search carries the stories on screen.
        const homeToSearch = from.pathname === "/" && to.pathname.startsWith("/search");
        listingTitles = articleNavigation || homeToSearch
          ? []
          : [...document.querySelectorAll<HTMLElement>("[data-vt-title]")]
              .filter((title) => {
                const box = title.getBoundingClientRect();
                return box.bottom > 0 && box.top < innerHeight && box.width > 0;
              })
              .map((title) => title.dataset.vtTitle!)
              .filter((title, index, all) => all.indexOf(title) === index)
              .slice(0, 16);
        excerptTexts = new Map();
        for (const path of paths) {
          const excerpt = excerptTransitionName(path);
          const card = document.querySelector(`[data-vt-excerpt="${CSS.escape(excerpt)}"]`);
          if (card) excerptTexts.set(excerpt, normalise(shownText(card)));
        }
        nameCarried(document);
      });

      // Where a passage of text starts on screen: the first character of the
      // first match for these opening words inside root.
      function textStart(root: Element, words: string): DOMRect | null {
        const nodes: Text[] = [];
        const starts: number[] = [];
        let full = "";
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
        while (walker.nextNode()) {
          const node = walker.currentNode as Text;
          starts.push(full.length);
          nodes.push(node);
          full += node.data;
        }
        // The words are normalised (letters and digits only), so let any
        // punctuation or markup sit inside and between them on the page.
        const pattern = new RegExp(
          words
            .split(" ")
            .filter(Boolean)
            .map((word) =>
              [...word].map((char) => char.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("[^\\p{L}\\p{N}\\s]*"),
            )
            .join("[^\\p{L}\\p{N}]+"),
          "iu",
        );
        const match = pattern.exec(full);
        if (!match) return null;
        let index = 0;
        while (index + 1 < starts.length && starts[index + 1] <= match.index) index += 1;
        const node = nodes[index];
        const offset = match.index - starts[index];
        const range = document.createRange();
        range.setStart(node, offset);
        range.setEnd(node, Math.min(offset + 1, node.length));
        return range.getBoundingClientRect();
      }

      // Each carried excerpt piece flies from where its words were on the page
      // being left to where they land. Going out, an article paragraph starts
      // at its opening words inside the clicked card's excerpt; coming back,
      // the card's excerpt starts at its paragraph in the article. A piece
      // with no source just rises a little into place.
      type Flight = { element: HTMLElement; from: DOMRect | null; share?: number };

      // A source position only counts if it's on screen.
      const visibleBox = (box: DOMRect | null | undefined) =>
        box && box.bottom > 0 && box.top < innerHeight && box.right > 0 && box.left < innerWidth ? box : null;

      function planExcerptFlights(newDocument: Document) {
        const flights: Flight[] = [];
        for (const path of new Set(paths)) {
          const excerpt = excerptTransitionName(path);
          const oldCard = document.querySelector(`[data-vt-excerpt="${CSS.escape(excerpt)}"]`);
          const oldBody = document.querySelector(`[data-vt-body="${CSS.escape(excerpt)}"]`);
          newDocument
            .querySelectorAll<HTMLElement>("[data-vt-carried]")
            .forEach((element) => {
              const name = element.style.viewTransitionName;
              if (name !== excerpt && !name.startsWith(`${excerpt}-`)) return;
              const words = openingWords(normalise(element.textContent ?? ""));
              let from: DOMRect | null = null;
              if (oldCard) from = textStart(oldCard, words.split(" ").slice(0, 4).join(" "));
              else if (oldBody) {
                const text = normalise(element.textContent ?? "");
                const block = excerptBlocks(oldBody, text)[0];
                from = block ? block.getBoundingClientRect() : null;
              }
              flights.push({ element, from: visibleBox(from) });
            });
        }
        // Listing to listing: each card excerpt flies from the same story's
        // excerpt on the page being left.
        for (const title of listingTitles) {
          const excerpt = title.replace(/^title-/, "excerpt-");
          const element = newDocument.querySelector<HTMLElement>(`[data-vt-excerpt="${CSS.escape(excerpt)}"]`);
          const old = document.querySelector(`[data-vt-excerpt="${CSS.escape(excerpt)}"]`);
          if (element?.dataset.vtCarried !== undefined) {
            flights.push({ element, from: old ? old.getBoundingClientRect() : null });
          }
          // The card moves two thirds of the way its title does.
          const card = newDocument
            .querySelector(`[data-vt-title="${CSS.escape(title)}"]`)
            ?.closest<HTMLElement>(cardSelector);
          const oldTitle = document.querySelector(`[data-vt-title="${CSS.escape(title)}"]`);
          if (card?.dataset.vtCarried !== undefined && oldTitle) {
            flights.push({ element: card, from: oldTitle.getBoundingClientRect(), share: 2 / 3 });
          }
        }
        return flights;
      }

      function flyExcerpts(flights: Flight[]) {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        // Same timing as the titles (--carry-duration in main.scss).
        const duration =
          parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--carry-duration") || "0.32") *
            1000 || 320;
        for (const { element, from, share = 1 } of flights) {
          const pseudoElement = `::view-transition-group(${element.style.viewTransitionName})`;
          // The browser places each group with a transform of its own, so the
          // flight starts from an offset added to that, not a bare translate.
          const end = getComputedStyle(document.documentElement, pseudoElement).transform;
          const placed = end && end !== "none" ? end : "";
          // A card is measured by its title, the thing that moves with it.
          const anchor = share < 1 ? (element.querySelector("[data-vt-title]") ?? element) : element;
          const to = anchor.getBoundingClientRect();
          const offset = from
            ? `translate(${(from.left - to.left) * share}px, ${(from.top - to.top) * share}px)`
            : "translateY(8px)";
          document.documentElement.animate(
            { transform: [`${offset} ${placed}`.trim(), placed || "none"] },
            { duration, easing: "cubic-bezier(0.2, 0, 0, 1)", pseudoElement },
          );
        }
      }

      document.addEventListener("astro:before-swap", (event) => {
        const { newDocument, viewTransition } = event as TransitionBeforeSwapEvent;
        nameCarried(newDocument);
        // Measuring and flying are extras: if either fails in some browser,
        // the transition carries on without them rather than stalling.
        let flights: Flight[] = [];
        try {
          flights = planExcerptFlights(newDocument);
        } catch {
          flights = [];
        }
        void viewTransition?.ready
          .then(() => {
            try {
              flyExcerpts(flights);
            } catch {
              // ignore
            }
          })
          .catch(() => {});
        // Unmark once the title has landed, which also brings its byline
        // back (see .byline in main.scss).
        const current = generation;
        void (viewTransition?.finished ?? Promise.resolve()).finally(() => {
          if (current === generation) clearCarried(document);
        });
      });
    </script>


    {openGraphType === "article" && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {openGraphType === "article" && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )}
    <link rel="icon" type="image/svg+xml" href="/SN%20H%20Logo.svg" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/feed.xml" />
    <!-- Privacy-friendly analytics by Plausible -->
    <script is:inline async src="https://plausible.io/js/pa-uvFjoLdnb2dzua4uEgT4v.js"></script>
    <script is:inline>
      // oxlint-disable-next-line eslint/no-unused-expressions
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
    <noscript>
      <style>
        .js-only {
          display: none !important;
        }
      </style>
    </noscript>
    <script is:inline>
      (function () {
        function applyTheme() {
          var root = document.documentElement;
          root.classList.remove("no-js");
          root.classList.add("js");

          try {
            var storedPreference = localStorage.getItem("dark-mode");
            var prefersDark =
              typeof window.matchMedia === "function" &&
              window.matchMedia("(prefers-color-scheme: dark)").matches;

            if (storedPreference === "false") {
              root.classList.remove("dark-mode");
              root.classList.add("light-mode");
              return;
            }

            if (storedPreference === "true" || (storedPreference === null && prefersDark)) {
              root.classList.remove("light-mode");
              root.classList.add("dark-mode");
            }
          } catch (_error) {
            // do nothing :)
          }
        }

        // Re-apply after every client-side navigation: the router can
        // replace <html>'s attributes with the freshly fetched page's
        // server-rendered ones, which never carry dark-mode/light-mode.
        applyTheme();
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>
    <script
      is:inline
      define:vars={{ pollOldClasses, pollStorageKey: POLL_STORAGE_KEY, pollPath: POLL_PATH }}
    >
      // Redesign poll preview: only inside the /redesign-poll frame, put back
      // the old looks the reader has picked (src/lib/redesign-poll.ts).
      (function () {
        var framed = false;
        try {
          framed = window.parent !== window && window.parent.location.pathname === pollPath;
        } catch (_error) {}
        if (!framed) return;

        function readChoices() {
          try {
            return JSON.parse(sessionStorage.getItem(pollStorageKey) || "{}").choices || {};
          } catch (_error) {
            return {};
          }
        }

        // Draw an emoji's first frame into a canvas after it. A canvas shows a
        // cross-origin image without needing CORS; it just can't be read back.
        function freezeEmoji(img) {
          if (img.hasAttribute("data-poll-still") || img.hasAttribute("data-poll-pending")) return;
          if (!img.complete || !img.naturalWidth) {
            img.setAttribute("data-poll-pending", "");
            img.addEventListener(
              "load",
              function () {
                img.removeAttribute("data-poll-pending");
                freezeEmoji(img);
              },
              { once: true }
            );
            return;
          }
          var canvas = document.createElement("canvas");
          canvas.width = img.naturalWidth;
          canvas.height = img.naturalHeight;
          canvas.getContext("2d").drawImage(img, 0, 0);
          canvas.className = "poll-emoji-still";
          canvas.setAttribute("role", "img");
          canvas.setAttribute("aria-label", img.alt);
          canvas.title = img.alt;
          img.after(canvas);
          img.setAttribute("data-poll-still", "");
        }

        function freezeAll() {
          if (!document.documentElement.classList.contains("poll-old-emoji")) return;
          document.querySelectorAll("img.emoji").forEach(freezeEmoji);
        }

        function apply() {
          var choices = readChoices();
          var root = document.documentElement;
          pollOldClasses.forEach(function (question) {
            root.classList.toggle(question.oldClass, choices[question.key] === "old");
          });
          freezeAll();
        }

        apply();
        document.addEventListener("astro:after-swap", apply);
        document.addEventListener("DOMContentLoaded", freezeAll);
        window.addEventListener("message", function (event) {
          if (event.origin === location.origin && event.data === pollStorageKey) apply();
        });
        // Slack columns and search results arrive after load.
        new MutationObserver(freezeAll).observe(document.documentElement, {
          childList: true,
          subtree: true,
        });
      })();
    </script>
    <script is:inline>
      (function () {
        function updateThemeButtonLabel() {
          var btn = document.getElementById("theme-toggle");
          if (!btn) return;
          btn.textContent = document.documentElement.classList.contains("dark-mode") ? "Light Mode" : "Dark Mode";
        }

        // Delegate from `document` instead of binding to the button directly:
        // client-side navigation replaces the header (and its button) with a
        // fresh node that would otherwise have no listener attached to it.
        document.addEventListener("click", function (event) {
          var btn = event.target.closest && event.target.closest("#theme-toggle");
          if (!btn) return;

          function swap() {
            var root = document.documentElement;
            root.classList.toggle("dark-mode");
            var isDark = root.classList.contains("dark-mode");
            root.classList.toggle("light-mode", !isDark);
            try {
              localStorage.setItem("dark-mode", String(isDark));
            } catch (_error) {
              // do nothing :)
            }
            updateThemeButtonLabel();
          }

          // The halftone wipe (src/lib/theme-wipe.ts), once its module has
          // loaded; a plain switch until then.
          if (window.__themeWipe) window.__themeWipe(btn, swap);
          else swap();
        });

        // The phone menu. The header is replaced on every navigation, so a
        // fresh page always starts with it closed.
        function setMenuOpen(nav, open) {
          nav.classList.toggle("site-nav--open", open);
          var toggle = nav.querySelector(".nav-toggle");
          if (toggle) toggle.setAttribute("aria-expanded", String(open));
        }

        document.addEventListener("click", function (event) {
          var openNav = document.querySelector(".site-nav--open");
          var toggle = event.target.closest && event.target.closest(".nav-toggle");
          if (toggle) {
            var nav = toggle.closest(".site-nav");
            setMenuOpen(nav, !nav.classList.contains("site-nav--open"));
            return;
          }
          // A tap outside the menu, or on a link in it, closes it.
          if (openNav && (!openNav.contains(event.target) || event.target.closest("a"))) {
            setMenuOpen(openNav, false);
          }
        });

        document.addEventListener("keydown", function (event) {
          if (event.key !== "Escape") return;
          var openNav = document.querySelector(".site-nav--open");
          if (!openNav) return;
          setMenuOpen(openNav, false);
          var toggle = openNav.querySelector(".nav-toggle");
          if (toggle) toggle.focus();
        });

        updateThemeButtonLabel();
        document.addEventListener("astro:page-load", updateThemeButtonLabel);
      })();
    </script>
  </head>
  <body>
    <header class="site-header" role="banner">
      <div class="wrapper">
        <div >
      <a class="site-title" rel="author" href="/">
            <img src="/Core%20SN%20logo.svg" alt={siteTitle} style="height: 2em; vertical-align: middle;" />
          </a>
                </div>
        <nav class="site-nav" aria-label="Site">
          <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Menu">
            <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
              <path class="nav-toggle-open" d="M2 5h16M2 10h16M2 15h16" />
              <path class="nav-toggle-close" d="M4 4l12 12M16 4L4 16" />
            </svg>
          </button>
          <div class="trigger" id="site-menu">
            <a class="page-link" href="/search/">Search</a>
            <span class="nav-pip">|</span>
            <a class="page-link" href="/about/">About</a>
            <span class="nav-pip">|</span>
            <a class="page-link" href="/submissions/">Submissions</a>
            <span class="nav-pip">|</span>
            <a class="page-link" href="https://hackclub.com">Hack Club</a>
            <span class="nav-pip">|</span>
            <a class="page-link" href="https://news.hackclub.com/rss">RSS</a>
            <span class="nav-pip">|</span>
            <a class="page-link" href="https://plausible.io/news.hackclub.com">Stats</a>
            <span class="nav-pip js-only">|</span>
            <button class="page-link theme-toggle js-only" id="theme-toggle" type="button">Dark Mode</button>
              {isAuthenticated ? (
            <a class="action-button" href="/auth/logout">Log out</a>
          ) : (
            <a class="action-button" href={`/auth/login?returnTo=${encodeURIComponent(authReturnTo)}`}>Log in</a>
          )}

          </div>
        </nav>
      </div>
      <div id="news-ticker" transition:persist="news-ticker">
        <NewsTicker />
      </div>
    </header>
    <script is:inline>
      (function () {
        var STORAGE_KEY = "news-ticker:collapsed";

        // An explicit toggle wins; until the reader makes one, the ticker
        // starts collapsed for anyone who asked their system to reduce
        // motion. The in-memory copy keeps a toggle working when storage
        // is unavailable, and survives client-side navigation.
        function isCollapsedPreference() {
          if (typeof window.__newsTickerCollapsed === "boolean") {
            return window.__newsTickerCollapsed;
          }
          try {
            var stored = localStorage.getItem(STORAGE_KEY);
            if (stored !== null) return stored === "true";
          } catch (_error) {
            // Fall through to the motion preference.
          }
          return (
            typeof window.matchMedia === "function" &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches
          );
        }

        // The red "newswire" box itself is the toggle: collapsing hides
        // everything else in the ticker bar but leaves that box in place
        // to expand it again.
        function applyTickerCollapse() {
          var collapsed = isCollapsedPreference();
          document.querySelectorAll(".news-ticker").forEach(function (ticker) {
            ticker.classList.toggle("news-ticker--collapsed", collapsed);
          });
          document.querySelectorAll(".news-ticker-label").forEach(function (label) {
            label.setAttribute("aria-label", collapsed ? "Show newswire ticker" : "Hide newswire ticker");
          });
        }

        applyTickerCollapse();
        document.addEventListener("astro:after-swap", applyTickerCollapse);

        document.addEventListener("click", function (event) {
          var label = event.target.closest && event.target.closest(".news-ticker-label");
          if (!label) return;

          var next = !isCollapsedPreference();
          window.__newsTickerCollapsed = next;
          try {
            localStorage.setItem(STORAGE_KEY, String(next));
          } catch (_error) {
            // Ignore unavailable browser storage; state just won't persist.
          }
          applyTickerCollapse();
        });
      })();
    </script>

    <main class="page-content" aria-label="Content">
      <div class="wrapper">
        <slot />
      </div>
    </main>
    <script is:inline>
      (function () {
        var channelPromises = new Map();

        function fetchChannel(identifier) {
          if (!channelPromises.has(identifier)) {
            channelPromises.set(identifier, fetch("https://flaron.halceon.dev/channel/" + encodeURIComponent(identifier))
              .then(function (response) { return response.ok ? response.json() : null; })
              .catch(function () { return null; }));
          }
          return channelPromises.get(identifier);
        }

        function hydrate(root) {
          var scope = root.querySelectorAll ? root : document;
          scope.querySelectorAll("[data-slack-channel-id]:not([data-slack-hydrated]), [data-slack-channel-lookup]:not([data-slack-hydrated])").forEach(function (element) {
            element.setAttribute("data-slack-hydrated", "true");
            var identifier = element.getAttribute("data-slack-channel-id") || element.getAttribute("data-slack-channel-lookup");
            fetchChannel(identifier).then(function (channel) {
              if (!channel || !channel.id) return;
              if (element.hasAttribute("data-slack-channel-lookup")) {
                var link = document.createElement("a");
                link.href = "https://hackclub.slack.com/archives/" + encodeURIComponent(channel.id);
                link.className = "slack_channel";
                link.target = "_blank";
                link.rel = "noreferrer noopener";
                link.textContent = "#" + (channel.name || identifier);
                element.replaceWith(link);
              } else {
                element.textContent = "#" + (channel.name || identifier);
              }
            });
          });
        }

        function scheduleHydration(root) {
          var run = function () { hydrate(root); };
          if (typeof window.requestIdleCallback === "function") window.requestIdleCallback(run, { timeout: 1000 });
          else window.setTimeout(run, 0);
        }

        scheduleHydration(document);
        new MutationObserver(function (mutations) {
          mutations.forEach(function (mutation) {
            mutation.addedNodes.forEach(function (node) {
              if (node.nodeType === Node.ELEMENT_NODE) scheduleHydration(node);
            });
          });
        }).observe(document.body, { childList: true, subtree: true });
      })();
    </script>
    <AbacusCounter pathname={Astro.url.pathname} />
    <SiteFooter />
  </body>
</html>
