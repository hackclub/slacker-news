---
interface Props {
    id: string;
    label?: string;
}

const { id, label } = Astro.props;
let displayName = label ?? id;

if (/^C[A-Z0-9]+$/i.test(id)) {
    try {
        const response = await fetch(`https://flaron.halceon.dev/channel/${encodeURIComponent(id)}`);
        if (response.ok) {
            const channel = await response.json() as { name?: string };
            displayName = channel.name?.trim() || displayName;
        }
    } catch {
        // Keep the supplied label or ID when Flaron is unavailable.
    }
}
---

<a href={`https://hackclub.slack.com/archives/${encodeURIComponent(id)}`} class="slack_channel" target="_blank" rel="noreferrer noopener">#{displayName}</a>
