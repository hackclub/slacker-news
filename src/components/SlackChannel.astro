---
interface Props {
    id: string;
    label?: string;
}

const { id, label } = Astro.props;
let displayName = label ?? id;

---

<a
  href={`https://hackclub.slack.com/archives/${encodeURIComponent(id)}`}
  class="slack_channel"
  data-slack-channel-id={!label && /^C[A-Z0-9]+$/i.test(id) ? id : undefined}
  target="_blank"
  rel="noreferrer noopener"
>#{displayName}</a>
