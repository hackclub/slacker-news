---
interface Props {
    name: string;
    id: string;
}

import { getSlackUserDisplayName } from "../lib/slack-users";

const { name, id } = Astro.props;
const suppliedName = name?.trim();
let displayName: string | undefined = suppliedName;

if (/^[UW][A-Z0-9]+$/i.test(id)) {
    displayName = await getSlackUserDisplayName(id)
        ?? (suppliedName && !/^[UW][A-Z0-9]+$/i.test(suppliedName) && suppliedName.toLowerCase() !== "slack user"
            ? suppliedName
            : undefined);
}

if (!displayName || /^[UW][A-Z0-9]+$/i.test(displayName)) {
    displayName = id === "here" || id === "channel" || id === "everyone" ? id : "Slack user";
}
---

<a
  href={`https://hackclub.slack.com/team/${encodeURIComponent(id)}`}
  class="slack_user"
  target="_blank"
  rel="noreferrer noopener"
>@{displayName}</a>
