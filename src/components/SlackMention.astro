---
interface Props {
    name: string;
    id: string;
}

const { name, id } = Astro.props;
let displayName = name;

if (!displayName || /^[UW][A-Z0-9]+$/i.test(displayName)) {
    displayName = id === "here" || id === "channel" || id === "everyone" ? id : "Slack user";
}
---

<a
  href={`https://hackclub.slack.com/team/${encodeURIComponent(id)}`}
  class="slack_user"
  data-slack-user-id={/^[UW][A-Z0-9]+$/i.test(id) ? id : undefined}
  data-slack-user-fallback={displayName}
  target="_blank"
  rel="noreferrer noopener"
>@{displayName}</a>
