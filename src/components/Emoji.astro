---
interface Props {
    name: string;
    src?: string;
}

const { name, src } = Astro.props;
const imgSrc = src ?? `https://cachet.hackclub.com/emojis/${name}/r`;
---

<img
  src={imgSrc}
  alt={`:${name}:`}
  class="emoji"
  onerror="this.remove()"
  />

<style>
    .emoji {
        height: 1.2em;
        vertical-align: middle;
        display: inline;
        filter: grayscale(100%);
    }
    .emoji:hover {
      filter: grayscale(0%);
    }

    /* In dark mode the page is inverted and every image inverted back
       (main.scss). A filter set here replaces that one, so these carry it,
       or the emoji come out inverted. */
    :global(html.dark-mode) .emoji {
      filter: invert(1) hue-rotate(180deg) grayscale(100%);
    }
    :global(html.dark-mode) .emoji:hover {
      filter: invert(1) hue-rotate(180deg) grayscale(0%);
    }
    @media (prefers-color-scheme: dark) {
      :global(html:not(.light-mode):not(.dark-mode)) .emoji {
        filter: invert(1) hue-rotate(180deg) grayscale(100%);
      }
      :global(html:not(.light-mode):not(.dark-mode)) .emoji:hover {
        filter: invert(1) hue-rotate(180deg) grayscale(0%);
      }
    }
</style>
