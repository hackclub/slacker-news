---
interface Props {
    name: string;
    src?: string;
}

const { name, src } = Astro.props;
const imgSrc = src ?? `https://cachet.dunkirk.sh/emojis/${name}/r`;
---

<img
  src={imgSrc}
  alt={`:${name}:`}
  class="emoji"
  onerror="this.remove()"
  />

<style>
    .emoji {
        height: 1.2em;
        vertical-align: middle;
        display: inline;
        filter: grayscale(100%);
    }
    .emoji:hover {
      filter: grayscale(0%);
    }
</style>
