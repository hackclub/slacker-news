---
import IndigestMetadata from "./IndigestMetadata.astro";
import SlackRichText from "./SlackRichText.astro";
import Byline from "./Byline.astro";
import { excerptTransitionName, titleTransitionName } from "../lib/transitions";
import { getSlackColumnData, getSlackColumns, firstMetadataValue } from "../lib/indigest";
import { getPosts } from "../lib/content";
import type { IndigestMessage } from "../lib/indigest";
import { editionNumbers } from "../lib/editions";
interface Props {
  returnTo?: string;
  }
  const { returnTo = "/" } = Astro.props;
const traditionalColumns = new Set((await getPosts()).map((post) => post.category).filter(Boolean));
const homepageColumns = await Promise.all(
  getSlackColumns()
    .filter((column) =>
      column.homepage
      && !column.markdownColumns
      && !traditionalColumns.has(column.column)
      && (!column.authRequired || Astro.locals.user)
    )
    .map((column) => getSlackColumnData(
      column.column,
      column.homepageFetchLimit ?? column.homepageLimit ?? column.limit
    ))
);
const visibleHomepageColumns = homepageColumns.filter((column) => column !== undefined);
const protectedHomepageColumns = getSlackColumns().filter(
  (column) => column.homepage && column.authRequired && !Astro.locals.user
);

// A card's title: the message's own, else its edition for newsletter columns.
function cardTitle(
  column: { title: string; editionNumbers?: boolean; messages: IndigestMessage[] },
  message: IndigestMessage,
): string {
  const edition = column.editionNumbers ? editionNumbers(column.messages).get(message.slackTs) : undefined;
  return firstMetadataValue(message.metadata) ?? (edition ? `${column.title} #${edition}` : column.title);
}

function getMessagesPerRow(column: { homepageMessagesPerRow?: number }): number {
  return Math.min(Math.max(Math.round(column.homepageMessagesPerRow ?? 4), 1), 4);
}
---


  {visibleHomepageColumns.map((column) => (
  <>
    <section class="front-section slack-column-row">
      <header class="front-section-head">
        <h2 class="front-section-title"><a href={`/slack/${encodeURIComponent(column.column)}/`}>{column.title}</a></h2>
        {column.subtitle && <span class="front-section-note">{column.subtitle}</span>}
        <a class="front-section-more" href={`/slack/${encodeURIComponent(column.column)}/`}>All {column.title} &rarr;</a>
      </header>
      <div
        class="front-section-body front-grid slack-column-row-items"
        style={`--slack-columns: ${getMessagesPerRow(column)}`}
      >
        {column.messages.slice(0, column.homepageLimit ?? 5).map((message) => (
          <article class="slack-column-block">
            <a
              class="slack-column-card-link"
              href={`/slack/${encodeURIComponent(column.column)}/${encodeURIComponent(message.slackTs)}/`}
              aria-label={`Read ${cardTitle(column, message)}`}
            >Open message</a>
            <h3
              class="slack-column-card-title"
              data-vt-title={titleTransitionName(`/slack/${encodeURIComponent(column.column)}/${encodeURIComponent(message.slackTs)}/`)}
            >
              <a
                class="slack-column-card-title-link"
                href={`/slack/${encodeURIComponent(column.column)}/${encodeURIComponent(message.slackTs)}/`}
              >
                {cardTitle(column, message)}
              </a>
              {" "}<Byline slackUserId={message.userId} slackUserName={message.userName} href={`/slack/${encodeURIComponent(column.column)}/${encodeURIComponent(message.slackTs)}/`} />
            </h3>
            <span data-vt-excerpt={excerptTransitionName(`/slack/${encodeURIComponent(column.column)}/${encodeURIComponent(message.slackTs)}/`)}><SlackRichText text={message.text} /></span>
            {column.showMetadata && <IndigestMetadata metadata={message.metadata} schema={column.metadataSchema} compact />}
          </article>
         
        ))}
        {column.messages.length === 0 && <p class="slack-empty">No data is available right now.</p>}
        
      </div>
      
    </section>
    </>
  ))}
  {protectedHomepageColumns.length > 0 && (
    <section class="front-section slack-auth-prompt">
      <p class="front-section-body">
        <a href={`/auth/login?returnTo=${encodeURIComponent(returnTo)}`}>

          Sign in with Hack Club
        </a>
        {" "}to view protected articles.
      </p>
    </section>
  )}
