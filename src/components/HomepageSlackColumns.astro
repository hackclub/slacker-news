---
import IndigestMetadata from "./IndigestMetadata.astro";
import SlackChannel from "./SlackChannel.astro";
import SlackRichText from "./SlackRichText.astro";
import { getSlackColumnData, getSlackColumns, firstMetadataValue } from "../lib/indigest";
import { getPosts } from "../lib/content";
import type { IndigestMessage } from "../lib/indigest";

function splitSubtitle(subtitle: string): { prefix: string; channelLabel: string | null } {
  const match = subtitle.match(/^(.*)#(\S+)$/);
  return match ? { prefix: match[1], channelLabel: match[2] } : { prefix: subtitle, channelLabel: null };
}
interface Props {
  returnTo?: string;
  }
  const { returnTo = "/" } = Astro.props;
const traditionalColumns = new Set((await getPosts()).map((post) => post.category).filter(Boolean));
const homepageColumns = await Promise.all(
  getSlackColumns()
    .filter((column) =>
      column.homepage
      && !traditionalColumns.has(column.column)
      && (!column.authRequired || Astro.locals.user)
    )
    .map((column) => getSlackColumnData(
      column.column,
      column.homepageFetchLimit ?? column.homepageLimit ?? column.limit
    ))
);
const visibleHomepageColumns = homepageColumns.filter((column) => column !== undefined);
const protectedHomepageColumns = getSlackColumns().filter(
  (column) => column.homepage && column.authRequired && !Astro.locals.user
);

function getMessagesPerRow(column: { homepageMessagesPerRow?: number }): number {
  return Math.min(Math.max(Math.round(column.homepageMessagesPerRow ?? 4), 1), 8);
}
---


  {visibleHomepageColumns.map((column) => (
  <>
    <section class="slack-column-row" style={column.accent ? `--accent: ${column.accent}` : undefined}>
      <div class="section-kicker">
        <span class="section-label">{column.title}</span>
        {column.subtitle && (() => {
          const { prefix, channelLabel } = splitSubtitle(column.subtitle);
          return (
            <span class="section-kicker-note">
              {prefix}
              {channelLabel && <SlackChannel id={column.channelId ?? column.column} label={channelLabel} />}
            </span>
          );
        })()}
      </div>
      <div
        class:list={["slack-column-row-items", `slack-column-row-items--${getMessagesPerRow(column)}`]}
        style={`--slack-column-messages-per-row: ${getMessagesPerRow(column)}`}
      >
        {column.messages.slice(0, column.homepageLimit ?? 5).map((message) => (
          <article class="front-block slack-column-block">
            <a
              class="slack-column-card-link"
              href={`/slack/${encodeURIComponent(column.column)}/${encodeURIComponent(message.slackTs)}/`}
              aria-label={`Read ${firstMetadataValue(message.metadata) ?? column.title}`}
            >Open message</a>
            <h3 class="slack-column-card-title">
              <a
                class="slack-column-card-title-link"
                href={`/slack/${encodeURIComponent(column.column)}/${encodeURIComponent(message.slackTs)}/`}
              >
                {firstMetadataValue(message.metadata) ?? column.title}
              </a>
            </h3>
            <span><SlackRichText text={message.text} /></span>
            {column.showMetadata && <IndigestMetadata metadata={message.metadata} schema={column.metadataSchema} compact />}
          </article>
         
        ))}
        {column.messages.length === 0 && <p class="slack-empty">No data is available right now.</p>}
        
      </div>
      
    </section>
    <a
      class="news-archive-link"
      href={`/slack/${encodeURIComponent(column.column)}/`}
      style={column.accent ? `--accent: ${column.accent}` : undefined}
    >All {column.title} &rarr;</a>
    <hr class="section-rule" style={column.accent ? `--accent: ${column.accent}` : undefined} />
    </>
  ))}
  {protectedHomepageColumns.length > 0 && (
    <div class="slack-auth-prompt">
      <strong class="slack-auth-prompt-label">Members-only area</strong>
      <p>
        <a href={`/auth/login?returnTo=${encodeURIComponent(returnTo)}`}>Sign in with Hack Club</a>
        {" "}to access members-only posts.
      </p>
    </div>
  )}
