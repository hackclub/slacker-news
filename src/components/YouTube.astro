---
interface Props {
  /** The `v=` part of a watch URL. */
  id: string;
  title: string;
  /** Optional line under the player. */
  caption?: string;
}

const { id, title, caption } = Astro.props;

// youtube-nocookie keeps the embed from writing tracking cookies until the
// reader actually presses play.
const source = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}`;
const watchURL = `https://www.youtube.com/watch?v=${encodeURIComponent(id)}`;
const thumbnail = `https://i.ytimg.com/vi/${encodeURIComponent(id)}/maxresdefault.jpg`;
const thumbnailFallback = `https://i.ytimg.com/vi/${encodeURIComponent(id)}/hqdefault.jpg`;
---

<figure class="video-embed">
  <div class="video-embed-frame" data-video-embed data-src={source} data-title={title}>
    <button class="video-embed-play" type="button" aria-label={`Play: ${title}`}>
      <img
        class="video-embed-thumb"
        src={thumbnail}
        data-fallback={thumbnailFallback}
        alt=""
        loading="lazy"
        decoding="async"
      />
      <span class="video-embed-badge" aria-hidden="true"></span>
    </button>
    <noscript>
      <iframe
        src={source}
        title={title}
        loading="lazy"
        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </noscript>
  </div>
  <figcaption class="video-embed-caption">
    <a href={watchURL} rel="noreferrer noopener" target="_blank">{title}</a>
    {caption && <span class="video-embed-note">{caption}</span>}
  </figcaption>
</figure>

<script>
  // The player only loads once the reader asks for it, so an article with two
  // videos in it does not pull two YouTube players on first paint.
  function initialise(root: ParentNode) {
    root.querySelectorAll<HTMLElement>("[data-video-embed]").forEach((frame) => {
      if (frame.dataset.videoReady === "true") return;
      frame.dataset.videoReady = "true";

      const thumb = frame.querySelector<HTMLImageElement>(".video-embed-thumb");
      if (thumb?.dataset.fallback) {
        // Not every upload has a maxres still; hqdefault always exists.
        thumb.addEventListener("error", function onError() {
          thumb.removeEventListener("error", onError);
          thumb.src = thumb.dataset.fallback as string;
        });
      }

      frame.querySelector<HTMLButtonElement>(".video-embed-play")?.addEventListener("click", () => {
        const source = frame.dataset.src;
        if (!source) return;

        const player = document.createElement("iframe");
        player.src = `${source}?autoplay=1`;
        player.title = frame.dataset.title ?? "";
        player.allow =
          "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        player.referrerPolicy = "strict-origin-when-cross-origin";
        player.allowFullscreen = true;
        frame.replaceChildren(player);
      });
    });
  }

  initialise(document);
  document.addEventListener("astro:page-load", () => initialise(document));
</script>

<style>
  .video-embed {
    margin: 1.8rem 0;
  }

  .video-embed-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 2px solid #000;
    border-radius: 10px;
    overflow: hidden;
    background: #000;
  }

  .video-embed-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-embed-play {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: #000;
    cursor: pointer;
  }

  .video-embed-thumb {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-embed-badge {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 68px;
    height: 48px;
    transform: translate(-50%, -50%);
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.62);
    transition: background 0.15s;
  }

  /* The play triangle, drawn rather than imported, so nothing else has to load. */
  .video-embed-badge::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 52%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 10px 0 10px 17px;
    border-color: transparent transparent transparent #fff;
  }

  .video-embed-play:hover .video-embed-badge,
  .video-embed-play:focus-visible .video-embed-badge {
    background: rgba(0, 0, 0, 0.82);
  }

  /*
   * Dark mode on this site is a whole-page `invert(1) hue-rotate(180deg)`, with
   * images re-inverted to put them back. That re-inversion is what was twisting
   * the thumbnail's colours, so drop the colour instead of fighting it: the
   * still goes grey, and the player that replaces it on click is re-inverted
   * normally so the video itself keeps its colours.
   */
  :global(html.dark-mode) .video-embed-thumb {
    filter: grayscale(1) invert(1) hue-rotate(180deg);
  }

  :global(html.dark-mode) .video-embed-frame :global(iframe) {
    filter: invert(1) hue-rotate(180deg);
  }

  /* The badge is ordinary markup, so the page-wide invert reaches it too. */
  :global(html.dark-mode) .video-embed-badge {
    filter: invert(1) hue-rotate(180deg);
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not(.light-mode):not(.dark-mode)) .video-embed-thumb {
      filter: grayscale(1) invert(1) hue-rotate(180deg);
    }

    :global(html:not(.light-mode):not(.dark-mode)) .video-embed-frame :global(iframe) {
      filter: invert(1) hue-rotate(180deg);
    }

    :global(html:not(.light-mode):not(.dark-mode)) .video-embed-badge {
      filter: invert(1) hue-rotate(180deg);
    }
  }

  .video-embed-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin-top: 8px;
    font-size: 0.82rem;
  }

  .video-embed-caption a {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .video-embed-note {
    color: #5a5a52;
  }
</style>
