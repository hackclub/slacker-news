---
import SlackRichTextRenderer from "./SlackRichTextRenderer.astro";
import { decodeSlackEntities, type Token } from "../lib/slack-rich-text";

interface Props {
  text: string;
}

const { text } = Astro.props;
// Triple-backtick blocks come first so their fences never pair up as inline
// code. Styled spans treat <...> as one unit, so a link inside them can carry
// markers (like the _ in a Wikipedia URL) without ending the span.
const tokenPattern = /(```[\s\S]*?```|`[^`\n]+`|\*\*(?:<[^>\n]*>|[^*\n])+?\*\*|\*(?:<[^>\n]*>|[^*\n])+?\*|(?<!\w)_(?:<[^>\n]*>|[^_\n])+?_(?!\w)|(?<!\w)~(?:<[^>\n]*>|[^~\n])+?~(?!\w)|<https?:\/\/[^>|\s]+(?:\|[^>]*)?>|<@[^>]+>|<![^>]+>|<#.+?>|#[A-Za-z0-9][A-Za-z0-9_-]*|:[A-Za-z0-9_+-]+:|\b(?<![@\w.<&!#])(?:https?:\/\/)?(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}(?::\d{1,5})?(?:[/?#][^\s<>'"]*)?(?![a-z0-9-]))/gi;

function tokenize(input: string): Token[] {
  const tokens: Token[] = [];
  let lastIndex = 0;

  for (const match of input.matchAll(tokenPattern)) {
    const raw = match[0];
    const index = match.index ?? 0;
    if (index > lastIndex) tokens.push({ type: "text", value: input.slice(lastIndex, index) });

    if (raw.startsWith("```") && raw.endsWith("```") && raw.length >= 6) {
      // Code blocks are not rendered here (cards, excerpts); their text
      // reads as plain text, without fences.
      tokens.push({ type: "text", value: raw.slice(3, -3) });
    } else if (raw.startsWith("`") && raw.endsWith("`")) {
      tokens.push({ type: "code", value: decodeSlackEntities(raw.slice(1, -1)) });
    } else if (raw.startsWith("~") && raw.endsWith("~")) {
      tokens.push({ type: "strike", children: tokenize(raw.slice(1, -1)) });
    } else if (raw.startsWith("**") && raw.endsWith("**") && raw.length > 4) {
      // Markdown's **bold**, as pasted articles often use it.
      tokens.push({ type: "bold", children: tokenize(raw.slice(2, -2)) });
    } else if (raw.startsWith("*") && raw.endsWith("*")) {
      tokens.push({ type: "bold", children: tokenize(raw.slice(1, -1)) });
    } else if (raw.startsWith("_") && raw.endsWith("_")) {
      tokens.push({ type: "italic", children: tokenize(raw.slice(1, -1)) });
    } else if (raw.startsWith(":") && raw.endsWith(":")) {
      tokens.push({ type: "emoji", name: raw.slice(1, -1) });
    } else if (/^<https?:\/\//i.test(raw)) {
      const inner = raw.slice(1, -1);
      const separator = inner.indexOf("|");
      const rawUrl = separator >= 0 ? inner.slice(0, separator) : inner;
      const explicitLabel = separator >= 0 ? inner.slice(separator + 1) : "";
      const url = decodeSlackEntities(rawUrl.endsWith("&") ? rawUrl.slice(0, -1) : rawUrl);
      const label = decodeSlackEntities(explicitLabel || url);
      tokens.push({ type: "link", url, label });
    } else if (raw.startsWith("<#")) {
      const channel = raw.slice(2, -1).split("|", 2);
      tokens.push({ type: "channel", id: channel[0], name: channel[1] });
    } else if (raw.startsWith("#")) {
      tokens.push({ type: "channel-candidate", value: raw });
    } else if (/^(?:https?:\/\/)?(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}/i.test(raw)) {
      const trailing = raw.match(/[.,;:!?)\]'"”’»]+$/)?.[0] ?? "";
      const cleanUrl = trailing ? raw.slice(0, -trailing.length) : raw;
      tokens.push({
        type: "link",
        url: /^https?:\/\//i.test(cleanUrl) ? cleanUrl : `https://${cleanUrl}`,
        label: cleanUrl,
      });
      if (trailing) tokens.push({ type: "text", value: trailing });
    } else {
      const parts = raw.slice(2, -1).split("|", 2);
      const target = parts[0].replace(/^subteam\^/, "");
      const name = parts[1]?.replace(/^@/, "") ?? target;
      tokens.push({ type: "mention", id: target, name });
    }

    lastIndex = index + raw.length;
  }

  if (lastIndex < input.length) tokens.push({ type: "text", value: input.slice(lastIndex) });
  return tokens;
}

const tokens = tokenize(text);
---

<SlackRichTextRenderer tokens={tokens} />
