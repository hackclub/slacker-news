---
import Emoji from "./Emoji.astro";
import SlackChannel from "./SlackChannel.astro";
import SlackMention from "./SlackMention.astro";

interface Props {
  text: string;
}

type Token =
  | { type: "text"; value: string }
  | { type: "mention"; id: string; name: string }
  | { type: "channel"; id: string; name?: string }
  | { type: "channel-candidate"; value: string }
  | { type: "emoji"; name: string };

const { text } = Astro.props;
const tokenPattern = /(<@[^>]+>|<![^>]+>|<#.+?>|#[A-Za-z0-9][A-Za-z0-9_-]*|:[A-Za-z0-9_+\-]+:)/g;

function tokenize(input: string): Token[] {
  const tokens: Token[] = [];
  let lastIndex = 0;

  for (const match of input.matchAll(tokenPattern)) {
    const raw = match[0];
    const index = match.index ?? 0;
    if (index > lastIndex) tokens.push({ type: "text", value: input.slice(lastIndex, index) });

    if (raw.startsWith(":") && raw.endsWith(":")) {
      tokens.push({ type: "emoji", name: raw.slice(1, -1) });
    } else if (raw.startsWith("<#")) {
      const channel = raw.slice(2, -1).split("|", 2);
      tokens.push({ type: "channel", id: channel[0], name: channel[1] });
    } else if (raw.startsWith("#")) {
      tokens.push({ type: "channel-candidate", value: raw });
    } else {
      const parts = raw.slice(2, -1).split("|", 2);
      const target = parts[0].replace(/^subteam\^/, "");
      const name = parts[1]?.replace(/^@/, "") ?? target;
      tokens.push({ type: "mention", id: target, name });
    }

    lastIndex = index + raw.length;
  }

  if (lastIndex < input.length) tokens.push({ type: "text", value: input.slice(lastIndex) });
  return tokens;
}

async function resolveChannelCandidates(input: Token[]): Promise<Token[]> {
  const cache = new Map<string, Promise<Token>>();

  return Promise.all(input.map((token) => {
    if (token.type !== "channel-candidate") return token;
    const channelName = token.value.slice(1);
    const cached = cache.get(channelName);
    if (cached) return cached;

    const resolved = (async (): Promise<Token> => {
      try {
        const response = await fetch(`https://flaron.halceon.dev/channel/${encodeURIComponent(channelName)}`);
        if (!response.ok) return { type: "text", value: token.value };

        const channel = await response.json() as { id?: string; name?: string };
        if (!channel.id) return { type: "text", value: token.value };
        return { type: "channel", id: channel.id, name: channel.name ?? channelName };
      } catch {
        return { type: "text", value: token.value };
      }
    })();

    cache.set(channelName, resolved);
    return resolved;
  }));
}

const tokens = await resolveChannelCandidates(tokenize(text));
---

{tokens.map((token) => {
  if (token.type === "mention") return <SlackMention name={token.name} id={token.id} />;
  if (token.type === "channel") return <SlackChannel id={token.id} label={token.name} />;
  if (token.type === "emoji") return <Emoji name={token.name} />;
  return token.value;
})}
