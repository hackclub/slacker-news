---
import { getPosts } from "../lib/content";
import { getSlackColumns } from "../lib/indigest";
import { MAX_HEADLINES_PER_SOURCE } from "../lib/ticker-headlines";

// Article headlines come from local content, so they render with the page.
// Slack columns and figures stream in from the browser as each API answers.
const postCounts = new Map<string, number>();
const headlines = (await getPosts()).filter((post) => {
  const category = post.category ?? "post";
  const count = postCounts.get(category) ?? 0;
  if (count >= MAX_HEADLINES_PER_SOURCE) return false;
  postCounts.set(category, count + 1);
  return true;
});

// Protected columns' titles stay hidden from signed-out readers, as on the
// homepage.
const slackColumns = getSlackColumns()
  .filter((column) => !column.authRequired || Astro.locals.user)
  .map((column) => column.column);
---

<div
  class="news-ticker"
  aria-label="News ticker"
  data-ticker-live
  data-slack-columns={JSON.stringify(slackColumns)}
>
  <button class="news-ticker-label" type="button" aria-label="Hide newswire ticker"><span class="news-ticker-label-text">newswire</span></button>
  <div class="news-ticker-track">
    <div class="news-ticker-scroll" data-ticker>
      <span class="news-ticker-set" data-ticker-set>
        {headlines.map((headline) => (
          <>
            <a class="news-ticker-item" href={headline.url} data-ticker-headline>
              {headline.title}
            </a>
            <span class="news-ticker-divider" aria-hidden="true">◆</span>
          </>
        ))}
      </span>
    </div>
  </div>
  <button class="news-ticker-pause" aria-label="Pause ticker" type="button">❚❚</button>
</div>

<script>
  const PAUSE_STORAGE_KEY = "news-ticker:paused";

  function isPausedPreference() {
    try {
      return localStorage.getItem(PAUSE_STORAGE_KEY) === "true";
    } catch (_error) {
      return false;
    }
  }

  function setPauseButtonState(btn: Element, isPaused: boolean) {
    const glyph = isPaused ? "▶" : "❚❚";
    const label = isPaused ? "Resume ticker" : "Pause ticker";
    // Bail out when nothing changes: the page-wide MutationObserver below
    // reinitializes tickers on any DOM mutation, and an unconditional
    // textContent/attribute write here would re-trigger it every time,
    // looping forever.
    if (btn.textContent === glyph && btn.getAttribute("aria-label") === label) return;
    btn.textContent = glyph;
    btn.setAttribute("aria-label", label);
  }

  const awaitingShow = new WeakSet<Element>();

  function whenShown(element: Element, callback: () => void) {
    if (awaitingShow.has(element)) return;
    awaitingShow.add(element);
    const observer = new ResizeObserver(() => {
      if (!(element instanceof HTMLElement) || element.offsetWidth === 0) return;
      observer.disconnect();
      awaitingShow.delete(element);
      requestAnimationFrame(callback);
    });
    observer.observe(element);
  }

  function initializeTickers() {
    document
      .querySelectorAll("[data-ticker]:not([data-ticker-initialized])")
      .forEach((scroll) => {
        if (!(scroll instanceof HTMLElement)) return;
        const set = scroll.querySelector("[data-ticker-set]");
        if (!(set instanceof HTMLElement)) return;
        const parent = scroll.parentElement;
        if (!parent) return;

        // A ticker that loads collapsed has no width to measure; set it up
        // once it is shown instead of baking in zero-width animation values.
        const trackWidth = parent.offsetWidth;
        if (trackWidth === 0) {
          whenShown(parent, () => {
            initializeTickers();
            insertArrivals();
          });
          return;
        }
        scroll.setAttribute("data-ticker-initialized", "true");
        const items = Array.from(set.children);
        if (items.length === 0) return;

        let i = 0;
        while (set.offsetWidth < trackWidth) {
          const clone = items[i % items.length].cloneNode(true);
          set.appendChild(clone);
          i++;
        }

        const dupe = set.cloneNode(true);
        if (!(dupe instanceof HTMLElement)) return;
        dupe.setAttribute("aria-hidden", "true");
        scroll.appendChild(dupe);

        const setWidth = set.offsetWidth;
        const pxPerSecond = 30;
        const duration = setWidth / pxPerSecond;

        scroll.style.animationDuration = duration + "s";
        scroll.style.setProperty("--set-width", "-" + setWidth + "px");
        scroll.classList.add("news-ticker-animate");

        const startedAt = (
          window as Window & { __newsTickerStartedAt?: number }
        ).__newsTickerStartedAt;
        const animation = scroll.getAnimations()[0];
        if (typeof startedAt === "number" && animation) {
          animation.currentTime = (performance.now() - startedAt) % (duration * 1000);
        }

        if (isPausedPreference() && animation) {
          animation.pause();
        }
      });
  }

  function initializePauseButtons() {
    document.querySelectorAll(".news-ticker-pause").forEach((btn) => {
      setPauseButtonState(btn, isPausedPreference());

      if (btn.hasAttribute("data-pause-initialized")) return;
      btn.setAttribute("data-pause-initialized", "true");

      btn.addEventListener("click", () => {
        const nextIsPaused = !isPausedPreference();

        try {
          localStorage.setItem(PAUSE_STORAGE_KEY, String(nextIsPaused));
        } catch (_error) {
          // Ignore unavailable browser storage; state just won't persist.
        }

        document.querySelectorAll(".news-ticker").forEach((ticker) => {
          const scroll = ticker.querySelector(".news-ticker-scroll");
          if (scroll instanceof HTMLElement) {
            scroll.getAnimations().forEach((a) => (nextIsPaused ? a.pause() : a.play()));
          }
        });

        document.querySelectorAll(".news-ticker-pause").forEach((pauseBtn) => {
          setPauseButtonState(pauseBtn, nextIsPaused);
        });
      });
    });
  }

  function initializeHoverPause() {
    document.querySelectorAll(".news-ticker-track:not([data-hover-pause-initialized])").forEach((track) => {
      track.setAttribute("data-hover-pause-initialized", "true");
      const scroll = track.querySelector(".news-ticker-scroll");
      if (!(scroll instanceof HTMLElement)) return;

      track.addEventListener("mouseenter", () => {
        scroll.getAnimations().forEach((a) => a.pause());
      });

      track.addEventListener("mouseleave", () => {
        // Leave it paused if the user explicitly paused it with the button.
        if (isPausedPreference()) return;
        scroll.getAnimations().forEach((a) => a.play());
      });
    });
  }

  type TickerFigure = {
    label: string;
    value: string;
    change?: { direction: "up" | "down"; text: string };
  };

  type TickerHeadline = { title: string; href: string };

  type Arrival =
    | { kind: "figures"; figures: TickerFigure[] }
    | { kind: "headlines"; headlines: TickerHeadline[] };

  const FIGURE_SOURCES = ["otter", "clubs", "slack-data"];
  const HEADLINES_PER_FIGURE = 3;
  const PX_PER_SECOND = 30;

  // Scoped styles (padding, divider colour) key off Astro's data-astro-cid-*
  // attribute, so items built here copy it from a server-rendered item.
  function copyScope(from: Element, to: Element) {
    for (const attribute of Array.from(from.attributes)) {
      if (attribute.name.startsWith("data-astro-cid-")) to.setAttribute(attribute.name, "");
    }
  }

  function figureNodes(figure: TickerFigure, template: Element, divider: Element): Node[] {
    const item = document.createElement("span");
    item.className = "news-ticker-item news-ticker-figure";
    copyScope(template, item);

    const label = document.createElement("span");
    label.className = "news-ticker-figure-label";
    label.textContent = figure.label;
    const value = document.createElement("span");
    value.className = "news-ticker-figure-value";
    value.textContent = figure.value;
    item.append(label, value);

    if (figure.change) {
      const change = document.createElement("span");
      change.className = `news-ticker-figure-change news-ticker-figure-change--${figure.change.direction}`;
      change.textContent = `${figure.change.direction === "up" ? "▲" : "▼"}${figure.change.text}`;
      item.append(change);
    }

    return [item, divider.cloneNode(true)];
  }

  function headlineNodes(headline: TickerHeadline, template: Element, divider: Element): Node[] {
    const item = document.createElement("a");
    item.className = "news-ticker-item";
    item.href = headline.href;
    item.textContent = headline.title;
    item.setAttribute("data-ticker-headline", "");
    copyScope(template, item);
    return [item, divider.cloneNode(true)];
  }

  // Slip newly arrived items into the scrolling set without moving anything
  // the reader can see, keeping the animation's pixel offset. Headlines go
  // in as a block just past the visible stretch, so each Slack column shows
  // up next; figures go after every third headline, in the first free slot
  // that is off-screen.
  const pending: Arrival[] = [];

  function insertArrivals(arrival?: Arrival) {
    if (arrival) pending.push(arrival);
    const scroll = document.querySelector("#news-ticker [data-ticker-live] [data-ticker]");
    if (!(scroll instanceof HTMLElement) || pending.length === 0) return;
    const set = scroll.querySelector("[data-ticker-set]");
    const track = scroll.parentElement;
    if (!(set instanceof HTMLElement) || !track) return;

    // A collapsed ticker has no width to measure, so hold arrivals until it
    // is shown again. A shown ticker without an animation is standing still
    // for a reader who prefers reduced motion; it starts at offset zero.
    if (set.offsetWidth === 0) {
      whenShown(track, () => insertArrivals());
      return;
    }
    const animation = scroll.getAnimations()[0];

    const template = set.querySelector("[data-ticker-headline]");
    const divider = set.querySelector(".news-ticker-divider");
    if (!template || !divider) return;

    const setWidth = set.offsetWidth;
    const offset = (((Number(animation?.currentTime) || 0) / 1000) * PX_PER_SECOND) % setWidth;
    const visibleEnd = offset + track.offsetWidth;
    const setLeft = set.getBoundingClientRect().left;
    const isOffScreen = (element: Element) => {
      const x = element.getBoundingClientRect().right - setLeft;
      return !((x >= offset && x <= visibleEnd) || x <= visibleEnd - setWidth);
    };

    for (const next of pending.splice(0)) {
      if (next.kind === "headlines") {
        const nodes = next.headlines.flatMap((headline) => headlineNodes(headline, template, divider));
        const after = Array.from(set.querySelectorAll(".news-ticker-divider")).find(
          (candidate) => candidate.getBoundingClientRect().right - setLeft > visibleEnd,
        );
        if (after) after.after(...nodes);
        else set.append(...nodes);
        continue;
      }

      const freeSlots = Array.from(set.querySelectorAll("[data-ticker-headline]"))
        .filter((_, index) => (index + 1) % HEADLINES_PER_FIGURE === 0)
        .map((headline) => headline.nextElementSibling)
        .filter((slot): slot is Element => Boolean(slot) && !slot!.hasAttribute("data-figure-slot-filled"))
        .filter(isOffScreen);

      for (const figure of next.figures) {
        const nodes = figureNodes(figure, template, divider);
        const slot = freeSlots.shift();
        if (slot) {
          slot.setAttribute("data-figure-slot-filled", "");
          slot.after(...nodes);
        } else {
          set.append(...nodes);
        }
      }
    }

    // The duplicate set must match for the loop to stay seamless.
    scroll.querySelectorAll("[data-ticker-set]").forEach((other) => {
      if (other === set) return;
      const copy = set.cloneNode(true) as HTMLElement;
      copy.setAttribute("aria-hidden", "true");
      other.replaceWith(copy);
    });

    const width = set.offsetWidth;
    const currentTime = animation?.currentTime;
    scroll.style.animationDuration = width / PX_PER_SECOND + "s";
    scroll.style.setProperty("--set-width", "-" + width + "px");
    if (animation) animation.currentTime = currentTime ?? 0;
  }

  function fetchJson<T>(url: string): Promise<T[]> {
    return fetch(url)
      .then((response) => (response.ok ? response.json() : []))
      .catch(() => []);
  }

  // Each source is fetched separately and slotted in as it answers, so a
  // slow API only delays its own items. A failed source is just left out.
  function loadArrivals() {
    const ticker = document.querySelector("#news-ticker [data-ticker-live]");
    if (!(ticker instanceof HTMLElement) || ticker.hasAttribute("data-arrivals-requested")) return;
    ticker.setAttribute("data-arrivals-requested", "");

    let columns: string[] = [];
    try {
      columns = JSON.parse(ticker.dataset.slackColumns ?? "[]");
    } catch (_error) {
      // Without a column list, the ticker keeps its article headlines.
    }

    for (const column of columns) {
      fetchJson<TickerHeadline>(`/api/ticker-headlines/${encodeURIComponent(column)}.json`).then(
        (headlines) => headlines.length > 0 && insertArrivals({ kind: "headlines", headlines }),
      );
    }

    for (const source of FIGURE_SOURCES) {
      fetchJson<TickerFigure>(`/api/ticker-figures/${source}.json`).then(
        (figures) => figures.length > 0 && insertArrivals({ kind: "figures", figures }),
      );
    }
  }

  function initializeAllTickers() {
    // Run before collapsing: measuring a hidden (display:none) track
    // would bake in zero-width animation values that never get fixed
    // once the ticker is expanded again.
    initializeTickers();
    initializePauseButtons();
    initializeHoverPause();
    loadArrivals();
  }

  function saveTickerPositions() {
    document
      .querySelectorAll(
        ".news-ticker-scroll",
      )
      .forEach((scroll) => {
        if (!(scroll instanceof HTMLElement)) return;

        const currentTime = scroll.getAnimations()[0]?.currentTime;
        if (typeof currentTime === "number") {
          scroll.setAttribute("data-ticker-current-time", String(currentTime));
          scroll.setAttribute("data-ticker-saved-at", String(performance.now()));
        }
      });
  }

  function restoreTickerPositions() {
    document
      .querySelectorAll(
        ".news-ticker-scroll[data-ticker-current-time]",
      )
      .forEach((scroll) => {
        if (!(scroll instanceof HTMLElement)) return;

        const currentTime = Number(scroll.getAttribute("data-ticker-current-time"));
        const savedAt = Number(scroll.getAttribute("data-ticker-saved-at"));
        const duration = parseFloat(getComputedStyle(scroll).animationDuration) * 1000;
        const navigationTime = Number.isFinite(savedAt)
          ? performance.now() - savedAt
          : 0;

        if (!Number.isFinite(currentTime) || duration <= 0) return;

        const animation = scroll.getAnimations()[0];
        if (!animation) return;

        scroll.style.animationDelay = "0s";
        animation.currentTime = (currentTime + navigationTime) % duration;
        animation.play();
      });
  }

  function initializeAllTickersAndRestorePosition() {
    initializeAllTickers();
    restoreTickerPositions();
  }

  initializeAllTickers();
  document.addEventListener("astro:before-swap", saveTickerPositions);
  document.addEventListener("astro:after-swap", initializeAllTickersAndRestorePosition);
  document.addEventListener("astro:page-load", initializeAllTickersAndRestorePosition);
  new MutationObserver(initializeAllTickers).observe(document.body, {
    childList: true,
    subtree: true,
  });
</script>

<style>
  .news-ticker {
    background: #f5f5f0;
    color: #000;
    display: flex;
    align-items: stretch;
    overflow: hidden;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    line-height: 1;
    border-top: 3px solid #000;
    border-bottom: 3px double #000;
  }


  .news-ticker-track {
    flex: 1;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .news-ticker-scroll {
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  .news-ticker-animate {
    animation: ticker-scroll linear infinite;
  }

  .news-ticker-set {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .news-ticker-item {
    padding: 8px 0;
  }

  .news-ticker-divider {
    margin: 0 1.2em;
    font-size: 0.45em;
    vertical-align: middle;
    color: var(--hc-muted);
  }

  .news-ticker-pause {
    flex: 0 0 auto;
    height: 31px;
    padding: 0 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-left: 2px solid #000;
    background: #f5f5f0;
    font-size: 0.7rem;
    line-height: 1;
    cursor: pointer;
    font-family: inherit;
    color: #000;
    transition: background 0.15s, color 0.15s;
  }

  .news-ticker-pause:hover {
    background: #fff;
  }

  @keyframes ticker-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(var(--set-width));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .news-ticker-animate {
      animation: none;
    }
  }
</style>
