---
import SlackRichText from "./SlackRichText.astro";
import { decodeSlackEntities, parseSlackBlocks, type SlackBlock } from "../lib/slack-rich-text";

// Renders a whole Slack message as an article body: paragraphs, lists,
// quotes and code blocks, with SlackRichText for the text inside them.
interface Props {
  text?: string;
  blocks?: SlackBlock[];
}

const { text = "", blocks = parseSlackBlocks(text) } = Astro.props;
---

{blocks.map((block) => (
  block.type === "paragraph" ? (
    <p><SlackRichText text={block.text} /></p>
  ) : block.type === "quote" ? (
    <blockquote>
      {block.lines.map((line) => <p><SlackRichText text={line} /></p>)}
    </blockquote>
  ) : block.type === "code" ? (
    <pre><code>{decodeSlackEntities(block.text)}</code></pre>
  ) : block.type === "heading" ? (
    block.level === 2 ? <h2><SlackRichText text={block.text} /></h2>
      : block.level === 3 ? <h3><SlackRichText text={block.text} /></h3>
      : <h4><SlackRichText text={block.text} /></h4>
  ) : block.type === "table" ? (
    <table>
      <thead>
        <tr>
          {block.header.map((cell, column) => (
            <th style={block.align[column] ? `text-align: ${block.align[column]}` : undefined}><SlackRichText text={cell} /></th>
          ))}
        </tr>
      </thead>
      <tbody>
        {block.rows.map((row) => (
          <tr>
            {row.map((cell, column) => (
              <td style={block.align[column] ? `text-align: ${block.align[column]}` : undefined}><SlackRichText text={cell} /></td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  ) : block.ordered ? (
    <ol start={block.start}>
      {block.items.map((item) => (
        <li><SlackRichText text={item.text} />{item.children.length > 0 && <Astro.self blocks={item.children} />}</li>
      ))}
    </ol>
  ) : (
    <ul>
      {block.items.map((item) => (
        <li><SlackRichText text={item.text} />{item.children.length > 0 && <Astro.self blocks={item.children} />}</li>
      ))}
    </ul>
  )
))}
