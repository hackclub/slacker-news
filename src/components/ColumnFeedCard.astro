---
import SlackRichText from "./SlackRichText.astro";
import Byline from "./Byline.astro";
import type { ColumnFeedItem } from "../lib/column-feed";
import { truncateWords, formatStoryDate } from "../lib/content";
import { excerptTransitionName, titleTransitionName } from "../lib/transitions";

interface Props {
  item: ColumnFeedItem;
  variant: "opinion" | "story";
  homepage: boolean;
}

const { item, variant, homepage } = Astro.props;
const isSlack = item.kind === "slack";
const title = isSlack ? item.article.title : item.post.title;
const date = isSlack ? item.article.date : item.post.date;
const href = isSlack ? item.article.url : item.post.url;
const excerpt = isSlack ? item.message.text : item.post.excerpt;
const truncatedExcerpt = truncateWords(excerpt, 18);
const byline = isSlack
  ? {
      slackAuthor: item.article.author,
      slackUserId: item.message.userId,
      slackUserName: item.message.userName,
    }
  : { authors: item.post.author, slackIds: item.post.authorSlackIds };

const cardClass = variant === "opinion" ? "opinion-item" : ["front-block", "story-block"];
const titleClass = variant === "opinion" ? "opinion-title" : "story-block-title";
const excerptClass = variant === "opinion" ? "opinion-excerpt" : "story-block-excerpt";
---

{homepage ? (
  // On the homepage the byline holds Slack mention links, and links cannot
  // nest, so the whole-card link is a cover behind the content instead.
  <article class:list={[cardClass, "linked-card"]}>
    <a class="linked-card-cover" href={href} aria-hidden="true" tabindex="-1"></a>
    <header class="story-card-header">
      <h3 class={titleClass} data-vt-title={titleTransitionName(href)}>
        <a class="linked-card-title" href={href}>{title}</a>
        {" "}<Byline {...byline} />
      </h3>
    </header>
    {isSlack ? (
      <p class:list={[excerptClass, "slack-feed-excerpt"]} data-vt-excerpt={excerptTransitionName(href)}>
        <SlackRichText text={truncatedExcerpt} />
      </p>
    ) : (
      <p class={excerptClass} data-vt-excerpt={excerptTransitionName(href)}>{truncatedExcerpt}</p>
    )}
    <span class="reading-time">{isSlack ? item.readingTime : item.post.readingTime} min read</span>
  </article>
) : (
  <a href={href} class:list={[cardClass]}>
    <header class="story-card-header">
      <h3 class={titleClass} data-vt-title={titleTransitionName(href)}>{title}</h3>
      {date ? (<time class="story-card-date" datetime={date.toISOString()}>{formatStoryDate(date)}</time>) : null}
    </header>
    {isSlack ? (
      <p class:list={[excerptClass, "slack-feed-excerpt"]} data-vt-excerpt={excerptTransitionName(href)}>
        <SlackRichText text={truncatedExcerpt} />
      </p>
    ) : (
      <p class={excerptClass} data-vt-excerpt={excerptTransitionName(href)}>{truncatedExcerpt}</p>
    )}
    <span class="reading-time">{isSlack ? item.readingTime : item.post.readingTime} min read</span>
  </a>
)}
