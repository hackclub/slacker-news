---
import BaseLayout from "../layouts/BaseLayout.astro";
import { avatarSrc, avatarUrl } from "../lib/avatars";
import SlackMention from "../components/SlackMention.astro";
import {
  getAcknowledgementGroups,
  getSiteConfig,
  getStoryCounts,
  handleKey,
  type Acknowledgement,
} from "../lib/content";

const site = await getSiteConfig();
const { editors, technical, content, other } = await getAcknowledgementGroups();
const storyCounts = await getStoryCounts();

const sections: {
  id: string;
  title: string;
  note: string;
  people: Acknowledgement[];
  stories?: boolean;
}[] = [
  { id: "editors", title: "Editors", note: "Choose, edit and publish the stories.", people: editors },
  { id: "technical", title: "Technical", note: "Build and run the site.", people: technical },
  { id: "content", title: "Writers", note: "Wrote for Slacker News.", people: content, stories: true },
  { id: "thanks", title: "With thanks", note: "Helped along the way.", people: other },
].filter((section) => section.people.length > 0);

const everyone = new Set(sections.flatMap((section) => section.people.map((person) => handleKey(person.name))));

const avatars = new Map(
  await Promise.all(
    [...new Set(sections.flatMap((section) => section.people).flatMap((person) => (person.slackId ? [person.slackId] : [])))].map(
      async (id) => [id, await avatarSrc(id)] as const,
    ),
  ),
);

// A writer's stories, through search's author filter (one word of the handle).
function storiesLink(person: Acknowledgement): { href: string; label: string } | undefined {
  const count = storyCounts.get(handleKey(person.name));
  if (!count) return undefined;
  const word = person.name.trim().replace(/^@+/, "").split(/\s+/)[0];
  return {
    href: `/search/?q=${encodeURIComponent(`@${word}`)}`,
    label: `${count} ${count === 1 ? "story" : "stories"}`,
  };
}
---

<BaseLayout title="Acknowledgements" siteTitle={site.title} siteDescription={site.description}>
  <div class="credits">
    <header class="credits-head">
      <h1 class="credits-title">Acknowledgements</h1>
      <p class="credits-lede">
        Slacker News is written, edited and built by Hack Clubbers. These are
        the {everyone.size} people who make it.
      </p>
    </header>

    {sections.map((section) => (
      <section class="credits-section" aria-labelledby={`credits-${section.id}`}>
        <div class="credits-aside">
          <h2 class="credits-section-title" id={`credits-${section.id}`}>{section.title}</h2>
          <p class="credits-section-note">{section.note}</p>
        </div>
        <ul class:list={["credits-people", { "credits-people--lead": section.id === "editors" }]}>
          {section.people.map((person) => {
            const userName = person.name.trim().replace(/^@+/, "");
            const stories = section.stories ? storiesLink(person) : undefined;
            const src = person.slackId ? avatars.get(person.slackId) : undefined;
            return (
              <li class="credits-person">
                {person.slackId && src ? (
                  <img
                    class="credits-avatar"
                    src={src}
                    data-fallback={src.startsWith("/") ? undefined : avatarUrl(person.slackId)}
                    onerror="if (this.dataset.fallback) { this.src = this.dataset.fallback; delete this.dataset.fallback; } else { this.replaceWith(Object.assign(document.createElement('span'), { className: 'credits-avatar credits-avatar--blank' })); }"
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width="44"
                    height="44"
                  />
                ) : (
                  <span class="credits-avatar credits-avatar--blank" aria-hidden="true" />
                )}
                <span class="credits-who">
                  <span class="credits-name">
                    {person.slackId ? <SlackMention name={userName} id={person.slackId} /> : person.name}
                  </span>
                  {stories && (
                    <a class="credits-stories" href={stories.href}>{stories.label}</a>
                  )}
                </span>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
