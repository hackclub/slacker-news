---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getSiteConfig } from "../../../lib/content";
import { getIndigestMessage, getIndigestMetadataSchema, getSlackColumn,  slackLinkFromMessageId } from "../../../lib/indigest";
import IndigestMetadata from "../../../components/IndigestMetadata.astro";
import SlackMention from "../../../components/SlackMention.astro";
import SlackRichText from "../../../components/SlackRichText.astro";

export const prerender = false;

const channel = Astro.params.channel ?? "";
const messageId = Astro.params.messageId ?? "";
const column = getSlackColumn(channel);
if (column?.authRequired && !Astro.locals.user) {
  return Astro.redirect(`/auth/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
}
const [message, metadataSchema] = column
  ? await Promise.all([
      getIndigestMessage(column.channelId ?? channel, messageId),
      getIndigestMetadataSchema(column.channelId ?? channel)
    ])
  : [undefined, undefined];
const site = await getSiteConfig();

function firstMetadataValue(metadata: Record<string, unknown> | string | undefined): string | undefined {
  let parsed: Record<string, unknown> | undefined;

  if (typeof metadata === "string") {
    try {
      const value = JSON.parse(metadata);
      if (value && typeof value === "object" && !Array.isArray(value)) parsed = value;
    } catch {
      return undefined;
    }
  } else if (metadata && typeof metadata === "object") {
    parsed = metadata as Record<string, unknown>;
  }

  const firstValue = parsed ? Object.values(parsed)[0] : undefined;
  if (typeof firstValue === "string" && firstValue.trim()) return firstValue.trim();
  if (firstValue !== undefined && firstValue !== null) return String(firstValue);
  return undefined;
}

const messageTitle = message ? firstMetadataValue(message.metadata) ?? column?.title ?? "Slack message" : undefined;

if (!column || !message) {
  Astro.response.status = 404;
  Astro.response.headers.set("Cache-Control", "no-store");
} else {
  Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800");
  }
---

<BaseLayout
    title={message ? `${messageTitle} | Slacker News` : "Slacker News"}
  siteTitle={site.title}
  siteDescription={site.description}
  canonicalPath={`/slack/${encodeURIComponent(channel)}/${encodeURIComponent(messageId)}/`}
>
  {column && message ? (
    <article class="story-page slack-story-page">
      <header class="story-header">
        <h1 class="story-title">{messageTitle}</h1>
        <div class="story-meta">
          <span class="story-category">
            <a class="page-link" href={`/slack/${encodeURIComponent(channel)}/`}>{column.title}</a>
          </span>
          <span class="story-author">
            By <SlackMention name={message.userName || message.userId} id={message.userId} />
          </span>
          {" — "}
          <time datetime={message.timestamp}>
            {new Date(message.timestamp).toLocaleString("en-US", { dateStyle: "long", timeStyle: "short" })}
          </time>
        </div>
        <hr class="story-rule" />
      </header>

      <div class="story-body slack-story-body">
        <SlackRichText text={message.text} />
        {column.showMetadata && <IndigestMetadata metadata={message.metadata} schema={metadataSchema} />}
      </div>

      <footer class="story-footer">
        <a href={`/`}>&larr; Back to front page</a>
        <a href={ slackLinkFromMessageId(message.channelId, message.slackTs)}>View message on Slack&rarr;</a>
      </footer>
    </article>
  ) : (
    <article class="post"><h1>Message not found</h1><p>This Slack message is not available.</p></article>
  )}
</BaseLayout>
