---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthorList from "../components/AuthorList.astro";
import SlackAvatar from "../components/SlackAvatar.astro";
import SlackMention from "../components/SlackMention.astro";
import {
  getAcknowledgements,
  getChangelogEntries,
  getPosts,
  getSiteConfig,
  type LongChangelogEntry,
  type ChangelogEntry,
} from "../lib/content";
import HomepageSlackColumns from "../components/HomepageSlackColumns.astro";

import ColumnFeedCard from "../components/ColumnFeedCard.astro";
import Byline from "../components/Byline.astro";
import type { BylineSource } from "../lib/byline";
import { bylineTransitionName, excerptTransitionName, titleTransitionName } from "../lib/transitions";
import { getColumnFeedItems } from "../lib/column-feed";
import { paragraphsHtml, renderOpeningHtml } from "../lib/lead-excerpt";
import { stripSlackMrkdwn } from "../lib/search";
import { parseSlackBlocks } from "../lib/slack-rich-text";

export const prerender = false;

import { getSlackColumns } from "../lib/indigest";


const site = await getSiteConfig();
const posts = await getPosts();
const allChangelogs = await getChangelogEntries();
const longChangelogs = allChangelogs.filter((e) => e.kind === "long");

const allNews = posts.filter((post) => post.category === "news");

const [opinionItems, newsItems, essayItems] = await Promise.all([
  getColumnFeedItems("opinion", Boolean(Astro.locals.user)),
  getColumnFeedItems("news", Boolean(Astro.locals.user)),
  getColumnFeedItems("essays", Boolean(Astro.locals.user)),
]);

// News articles published from Slack can lead too. Their slug matches the
// markdown posts' form ("news/<slug>"), so headlineOverride can name them.
const slackNewsCandidates = newsItems.flatMap((item) =>
  item.kind === "slack"
    ? [{
        slug: item.article.url.replace(/^\/|\/$/g, ""),
        url: item.article.url,
        title: item.article.title,
        excerpt: "",
        body: undefined as string | undefined,
        // Same blocks as the article page, so quotes (including a leading
        // italic note) stay out of the excerpt, as they do for posts.
        paragraphs: parseSlackBlocks(item.message.formattedText || item.message.text)
          .flatMap((block) => (block.type === "paragraph" ? [stripSlackMrkdwn(block.text)] : []))
          .filter(Boolean),
        date: item.date,
        leadingImage: undefined,
        byline: {
          slackAuthor: item.article.author,
          slackUserId: item.message.userId,
          slackUserName: item.message.userName,
        } as BylineSource,
      }]
    : [],
);

const allCandidates = [
  ...slackNewsCandidates,
  ...allNews.map((p) => ({ slug: p.slug, url: p.url, title: p.title, excerpt: p.excerpt, paragraphs: p.paragraphs, body: p.entry.body, date: p.date, leadingImage: p.leadingImage, byline: { authors: p.author, slackIds: p.authorSlackIds } as BylineSource })),
  ...longChangelogs.map((c) => ({ slug: c.slug, url: c.url, title: c.title, excerpt: c.excerpt, paragraphs: c.paragraphs, body: c.entry.body, date: new Date(`${c.date}T00:00:00Z`), leadingImage: c.leadingImage, byline: { authors: c.author, slackIds: c.slackIds } as BylineSource })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

const headline = site.headlineOverride
  ? allCandidates.find((c) => c.slug === site.headlineOverride) ?? allCandidates[0]
  : allCandidates[0];
// The lead excerpt is the article's opening blocks as real HTML. It holds
// more than fits; the script below trims it to the space beside the opinion
// rail.
const headlineExcerptLimit = headline?.leadingImage ? 5 : 8;
const headlineExcerptHtml = headline?.body
  ? await renderOpeningHtml(headline.body, headlineExcerptLimit)
  : paragraphsHtml(headline?.paragraphs ?? [], headlineExcerptLimit);

const displayOpinion = opinionItems.slice(0, 3);

function changelogToPostLike(changelog: LongChangelogEntry) {
  return {
    kind: "post" as const,
    post: {
      slug: changelog.slug,
      url: changelog.url,
      title: changelog.title,
      excerpt: changelog.excerpt,
      readingTime: changelog.readingTime,
      author: changelog.author,
      authorSlackIds: changelog.slackIds,
      date: new Date(`${changelog.date}T00:00:00Z`),
    },
    date: new Date(`${changelog.date}T00:00:00Z`),
  };
}

const longChangelogItems = longChangelogs.map((c) => changelogToPostLike(c as LongChangelogEntry));

const combinedNewsAndChangelogs = [...newsItems, ...longChangelogItems]
  .filter((item) =>
    item.kind === "post"
      ? item.post.slug !== headline?.slug
      : item.article.url !== headline?.url
  )
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 8);

const displayNews = combinedNewsAndChangelogs;

const displayEssays = essayItems.slice(0, 4);

const acknowledgements = await getAcknowledgements();
// Changelog sits beside acknowledgements (two name columns), so show about as
// many entries as it takes to match that list's height.
const recentChangelog = allChangelogs.slice(0, Math.max(3, Math.ceil(acknowledgements.length / 4)));
// Markdown-column integrations show inside the opinion, news and essays
// sections instead of a row of their own.
const homepageSlackColumns = getSlackColumns().filter(
  (column) =>
    column.homepage &&
    !column.markdownColumns &&
    (!column.authRequired || Astro.locals.user)
);

function getSlackMessagesPerRow(column: { homepageMessagesPerRow?: number }): number {
  return Math.min(Math.max(Math.round(column.homepageMessagesPerRow ?? 4), 1), 4);
}

function getSlackHomepageLimit(column: { homepageLimit?: number; homepageFetchLimit?: number; limit?: number }): number {
  return Math.min(Math.max(Math.round(column.homepageLimit ?? column.homepageFetchLimit ?? column.limit ?? 5), 1), 100);
}
---

<BaseLayout siteTitle={site.title} siteDescription={site.description}>
  <div class="newspaper-front">
    <div class="front-top">
      {headline && (
        <article class="front-lead headline-block linked-card">
          <a class="linked-card-cover" href={headline.url} aria-hidden="true" tabindex="-1"></a>
          {headline.leadingImage && (
            <div class="headline-media">
              <img
                src={headline.leadingImage.src}
                alt={headline.leadingImage.alt}
                loading="eager"
                decoding="async"
              />
            </div>
          )}

          <div class="headline-content">
            <h2 class="block-headline" data-vt-title={titleTransitionName(headline.url)}>
              <a class="linked-card-title" href={headline.url}>{headline.title}</a>
              {" "}<Byline {...headline.byline} href={headline.url} />
            </h2>
            <div class="block-excerpts">
              <div
                id="headline-excerpt"
                data-vt-excerpt={excerptTransitionName(headline.url)}
                class="block-excerpt"
                set:html={headlineExcerptHtml}
              />
            </div>
          </div>
        </article>
      )}

      <section class="front-rail opinion-block">
        <header class="front-section-head">
          <h2 class="front-section-title"><a href="/opinion/">Opinion</a></h2>
          <a href="/opinion/" class="front-section-more">All opinion &rarr;</a>
        </header>
        {displayOpinion.map((item) => (
          <ColumnFeedCard item={item} variant="opinion" homepage={true} />
        ))}
      </section>
    </div>

    <section class="front-section">
      <header class="front-section-head">
        <h2 class="front-section-title"><a href="/news/">News</a></h2>
        <a href="/news/" class="front-section-more">All news &rarr;</a>
      </header>
      <div class="front-section-body front-grid">
        {displayNews.map((item) => (
          <ColumnFeedCard item={item} variant="story" homepage={true} />
        ))}
      </div>
    </section>

    {displayEssays.length > 0 && (
      <section class="front-section">
        <header class="front-section-head">
          <h2 class="front-section-title"><a href="/essays/">Essays</a></h2>
          <a href="/essays/" class="front-section-more">All essays &rarr;</a>
        </header>
        <div class="front-section-body front-grid front-grid--2">
          {displayEssays.map((item) => (
            <ColumnFeedCard item={item} variant="story" homepage={true} />
          ))}
        </div>
      </section>
    )}

    <HomepageSlackColumns server:defer returnTo={Astro.url.pathname}>
      <div slot="fallback" class="front-slack-columns">
        {homepageSlackColumns.map((column) => (
          <section class="front-section slack-column-row slack-column-row--loading">
            <header class="front-section-head">
              <h2 class="front-section-title"><a href={`/slack/${encodeURIComponent(column.column)}/`}>{column.title}</a></h2>
              {column.subtitle && <span class="front-section-note">{column.subtitle}</span>}
              <a class="front-section-more" href={`/slack/${encodeURIComponent(column.column)}/`}>All {column.title} &rarr;</a>
            </header>
            <div
              class="front-section-body front-grid slack-column-row-items"
              style={`--slack-columns: ${getSlackMessagesPerRow(column)}`}
            >
              {Array.from({ length: getSlackHomepageLimit(column) }).map(() => (
                <div class="slack-column-block slack-column-placeholder"></div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </HomepageSlackColumns>

    <div class="front-pair">
    <section class="front-pair-col">
      <header class="front-section-head">
        <h2 class="front-section-title"><a href="/changelogs/">Changelog</a></h2>
        <a href="/changelogs/" class="front-section-more">All changelogs &rarr;</a>
      </header>
      <div class="changelog-list">
        {recentChangelog.map((entry) => (
          <div class="changelog-item">
            {entry.kind === "long" ? (
              <a href={entry.url} class="changelog-change changelog-change-link" data-vt-title={titleTransitionName(entry.url)}>{entry.title}</a>
            ) : (
              <span class="changelog-change">{entry.change}</span>
            )}
            <span class="changelog-meta">
              {entry.date} &middot;{" "}
              <span
                class="changelog-byline"
                data-vt-byline={entry.kind === "long" ? bylineTransitionName(entry.url) : undefined}
              ><AuthorList authors={entry.author} slackIds={entry.slackIds} avatars /></span>
            </span>
          </div>
        ))}
      </div>
    </section>

    <section class="front-pair-col">
      <header class="front-section-head">
        <h2 class="front-section-title"><a href="/acknowledgements/">Acknowledgements</a></h2>
        <a href="/acknowledgements/" class="front-section-more">All &rarr;</a>
      </header>
      <div class="acknowledgements-grid">
        {acknowledgements.map((person) => {
          const userName = person.name.trim().replace(/^@+/, "");
          return (
            <span class="acknowledgement-name">
              {person.slackId ? <><SlackAvatar id={person.slackId} /><SlackMention name={userName} id={person.slackId} /></> : person.name}
            </span>
          );
        })}
      </div>
    </section>
    </div>
  </div>

  <script>
    // Fit the lead excerpt beside the opinion rail: drop whole trailing
    // blocks until it fits, then trim the last paragraph or list item to the
    // sentences that fit, keeping its formatting. Where the excerpt isn't
    // boxed in (narrow screens, the lead stacks above the rail) it keeps its
    // first three blocks instead.
    document.addEventListener("astro:page-load", () => {
      const excerpt = document.getElementById("headline-excerpt");
      const box = excerpt?.parentElement;
      if (!(excerpt instanceof HTMLElement) || !(box instanceof HTMLElement)) return;

      const original = excerpt.innerHTML;
      const segmenter =
        typeof Intl !== "undefined" && "Segmenter" in Intl
          ? new Intl.Segmenter(undefined, { granularity: "sentence" })
          : null;

      const leaves = () =>
        [...excerpt.querySelectorAll<HTMLElement>("p, li")].filter((block) => !block.querySelector("p, li"));
      const overflows = () => excerpt.scrollHeight > box.clientHeight + 1;

      // Remove a block, and any list or wrapper left empty by it.
      const removeBlock = (block: Element) => {
        let node = block;
        while (node.parentElement && node.parentElement !== excerpt && node.parentElement.children.length === 1) {
          node = node.parentElement;
        }
        node.remove();
      };

      // Character offsets where each sentence of this text ends.
      const sentenceEnds = (text: string): number[] => {
        if (segmenter) {
          return [...segmenter.segment(text)].map((part) => part.index + part.segment.trimEnd().length);
        }
        const ends: number[] = [];
        for (const match of text.matchAll(/[^.!?]+[.!?]+["\u201d\u2019)]*|[^.!?]+$/g)) {
          ends.push((match.index ?? 0) + match[0].trimEnd().length);
        }
        return ends;
      };

      // Cut a block's content after the given text offset, keeping its markup.
      const cutAfter = (block: HTMLElement, html: string, offset: number) => {
        block.innerHTML = html;
        const walker = document.createTreeWalker(block, NodeFilter.SHOW_TEXT);
        let seen = 0;
        while (walker.nextNode()) {
          const node = walker.currentNode as Text;
          if (seen + node.length >= offset) {
            const range = document.createRange();
            range.setStart(node, offset - seen);
            range.setEndAfter(block.lastChild!);
            range.deleteContents();
            return;
          }
          seen += node.length;
        }
      };

      const fit = () => {
        excerpt.innerHTML = original;
        const blocks = leaves();
        if (!getComputedStyle(box).contain.includes("size")) {
          blocks.slice(3).forEach(removeBlock);
          return;
        }
        if (box.clientHeight <= 0) return;

        // Drop whole blocks from the end until the rest fits.
        let dropped: { block: HTMLElement; parent: Node; next: Node | null; outer: Element } | null = null;
        while (overflows() && blocks.length > 1) {
          const block = blocks.pop()!;
          let outer: Element = block;
          while (outer.parentElement && outer.parentElement !== excerpt && outer.parentElement.children.length === 1) {
            outer = outer.parentElement;
          }
          dropped = { block, parent: outer.parentNode!, next: outer.nextSibling, outer };
          outer.remove();
        }

        // Then fill the room left with as many sentences as fit: of the
        // first dropped block if one was dropped, else of the only block.
        let last: HTMLElement;
        if (dropped) {
          dropped.parent.insertBefore(dropped.outer, dropped.next);
          last = dropped.block;
        } else if (overflows()) {
          last = blocks[0];
        } else {
          return;
        }
        if (!last) return;
        const html = last.innerHTML;
        const ends = sentenceEnds(last.textContent ?? "");
        let lo = 1;
        let hi = ends.length;
        let best = 0;
        while (lo <= hi) {
          const mid = Math.floor((lo + hi) / 2);
          cutAfter(last, html, ends[mid - 1]);
          if (overflows()) hi = mid - 1;
          else {
            best = mid;
            lo = mid + 1;
          }
        }
        if (best === 0) {
          // Not even one sentence of it fits: leave it out, unless it's the
          // only block, which keeps its first sentence.
          if (dropped) removeBlock(dropped.block);
          else cutAfter(last, html, ends[0]);
        } else if (best < ends.length) {
          cutAfter(last, html, ends[best - 1]);
        } else {
          last.innerHTML = html;
        }
      };

      let frame = 0;
      const scheduleFit = () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(fit);
      };
      scheduleFit();
      window.addEventListener("resize", scheduleFit);
      document.addEventListener("astro:before-swap", () => window.removeEventListener("resize", scheduleFit), {
        once: true,
      });
      void document.fonts?.ready.then(scheduleFit);
    });
  </script>
</BaseLayout>
