---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthorList from "../components/AuthorList.astro";
import SlackMention from "../components/SlackMention.astro";
import {
  getAcknowledgements,
  getChangelogEntries,
  getPosts,
  getSiteConfig,
  truncateWords
} from "../lib/content";
import HomepageSlackColumns from "../components/HomepageSlackColumns.astro";

import ColumnFeedCard from "../components/ColumnFeedCard.astro";
import { getColumnFeedItems } from "../lib/column-feed";

export const prerender = false;

import { getSlackColumns } from "../lib/indigest";


const site = await getSiteConfig();
const posts = await getPosts();

const allNews = posts.filter((post) => post.category === "news");
const overrideHeadline = site.headlineOverride
  ? posts.find((post) => post.slug === site.headlineOverride)
  : undefined;
const headline = overrideHeadline ?? allNews[0];
const headlineExcerptWordLimit = headline?.leadingImage ? 75 : 110;
const headlineExcerpts = (() => {
  const paras = headline?.paragraphs ?? [];
  const filtered = paras.filter((p) => {
    const s = p.replace(/\s+/g, " ").trim();
    if (!s) return false;
    if (/^#{1,6}\s+/.test(s)) return false;
    if (/^[=-]{3,}\s*$/.test(s)) return false;
    const words = s.split(/\s+/).length;
    if (words < 6) return false;
    if (s.length < 40) return false;
    return true;
  });

  return filtered.slice(0, headline?.leadingImage ? 2 : 3);
})();
const headlineExcerptText = headlineExcerpts.join("\n\n");

const [opinionItems, newsItems, essayItems] = await Promise.all([
  getColumnFeedItems("opinion", Boolean(Astro.locals.user)),
  getColumnFeedItems("news", Boolean(Astro.locals.user)),
  getColumnFeedItems("essays", Boolean(Astro.locals.user)),
]);

const displayOpinion = opinionItems.slice(0, 3);

const displayNews = newsItems
  .filter((item) => item.kind !== "post" || item.post.slug !== headline?.slug)
  .slice(0, 8);

const displayEssays = essayItems.slice(0, 4);

const recentChangelog = (await getChangelogEntries()).slice(0, 3);
const acknowledgements = await getAcknowledgements();
const homepageSlackColumns = getSlackColumns().filter((column) => column.homepage);

function getSlackMessagesPerRow(column: { homepageMessagesPerRow?: number }): number {
  return Math.min(Math.max(Math.round(column.homepageMessagesPerRow ?? 4), 1), 8);
}

function getSlackHomepageLimit(column: { homepageLimit?: number; homepageFetchLimit?: number; limit?: number }): number {
  return Math.min(Math.max(Math.round(column.homepageLimit ?? column.homepageFetchLimit ?? column.limit ?? 5), 1), 100);
}
---

<BaseLayout siteTitle={site.title} siteDescription={site.description}>
  <div class="newspaper-front">
    <div class="front-top">
      {headline && (
        <a href={headline.url} class="front-block headline-block">
          {headline.leadingImage && (
            <div class="headline-media">
              <img
                src={headline.leadingImage.src}
                alt={headline.leadingImage.alt}
                loading="eager"
                decoding="async"
              />
            </div>
          )}

          <div class="headline-content">
            <h2 class="block-headline">{headline.title}</h2>
            <hr class="block-rule" />
            <div class="block-excerpts">
              <p
                id="headline-excerpt"
                class="block-excerpt"
                data-source={headlineExcerptText}
              >
                {truncateWords(headlineExcerptText, headlineExcerptWordLimit)}
              </p>
            </div>
          </div>
        </a>
      )}

      <div class="front-block opinion-block">
        <div class="section-label">OPINION</div>
        <hr class="block-rule" />
        {displayOpinion.map((item, index) => (
          <>
          <ColumnFeedCard item={item} variant="opinion" homepage={true} />
            {index < displayOpinion.length - 1 && <hr class="opinion-divider" />}
          </>
        ))}
        {displayOpinion.length > 0 && <hr class="opinion-divider" />}
        <a href="/opinion/" class="archive-link">All opinion &rarr;</a>
      </div>
    </div>

    <div class={`front-bottom ${displayNews.length < 4 ? `front-bottom--${displayNews.length}` : ""}`}>
      {displayNews.map((item) => (
        <ColumnFeedCard item={item} variant="story" homepage={true}  />
      ))}
    </div>

    <a href="/news/" class="news-archive-link">All news &rarr;</a>

    {displayEssays.length > 0 && (
      <>
        <hr class="section-rule" />

        <div class={`front-essays ${displayEssays.length < 4 ? `front-essays--${displayEssays.length}` : ""}`}>
          {displayEssays.map((item) => (
            <ColumnFeedCard item={item} variant="story" homepage={true}  />
          ))}
        </div>

        <a href="/essays/" class="news-archive-link">All essays &rarr;</a>
      </>
    )}

    <hr class="section-rule" />

    <HomepageSlackColumns server:defer returnTo={Astro.url.pathname}>
      <div slot="fallback" class="front-slack-columns">
        {homepageSlackColumns.map((column) => (
          <>
            <section class="slack-column-row slack-column-row--loading">
              <div
                class:list={[
                  "slack-column-row-items",
                  `slack-column-row-items--${getSlackMessagesPerRow(column)}`
                ]}
                style={`--slack-column-messages-per-row: ${getSlackMessagesPerRow(column)}`}
              >
                {Array.from({ length: getSlackHomepageLimit(column) }).map(() => (
                  <div class="front-block slack-column-block slack-column-placeholder"></div>
                ))}
              </div>
            </section>
            <a class="news-archive-link" href={`/slack/${encodeURIComponent(column.channel)}/`}>All {column.title} &rarr;</a>
            <hr class="section-rule" />
          </>
        ))}
      </div>
    </HomepageSlackColumns>


    <div class="front-changelog">
      <div class="front-block changelog-block">
        <div class="section-label">CHANGELOG</div>
        <hr class="block-rule" />
        {recentChangelog.map((entry, index) => (
          <>
            <div class="changelog-item">
              {entry.kind === "long" ? (
                <a href={entry.url} class="changelog-change changelog-change-link">{entry.title}</a>
              ) : (
                <span class="changelog-change">{entry.change}</span>
              )}
              <span class="changelog-meta">
                {entry.date} &middot; <AuthorList authors={entry.author} slackIds={entry.slackIds} />
              </span>
            </div>
            {index < recentChangelog.length - 1 && <hr class="changelog-divider" />}
          </>
        ))}
        {recentChangelog.length > 0 && <hr class="changelog-divider" />}
        <a href="/changelogs/" class="archive-link">All changelogs &rarr;</a>
      </div>

      <div class="front-block acknowledgements-block">
        <div class="section-label">ACKNOWLEDGEMENTS</div>
        <hr class="block-rule" />
        <div class="acknowledgements-grid">
          {acknowledgements.map((person) => {
            const userName = person.name.trim().replace(/^@+/, "");
            return (
              <span class="acknowledgement-name">
                {person.slackId ? <SlackMention name={userName} id={person.slackId} /> : person.name}
              </span>
            );
          })}
        </div>
        <a href="/acknowledgements/" class="archive-link">All acknowledgements &rarr;</a>
      </div>
    </div>
  </div>

  <script>
    import { layout, prepare } from "@chenglou/pretext";

    const excerpt = document.getElementById("headline-excerpt");

    if (excerpt instanceof HTMLElement) {
      const source = excerpt.dataset.source ?? "";
      const sourceWords = source.trim().split(/\s+/).filter(Boolean);

      if (sourceWords.length > 0) {
        const sourceParagraphs = source.split(/\n{2,}/).map((paragraph) => paragraph.trim()).filter(Boolean);
        let frame = 0;

        function splitSentences(paragraph: string): string[] {
          if (typeof Intl !== "undefined" && typeof Intl.Segmenter === "function") {
            const segmenter = new Intl.Segmenter(undefined, { granularity: "sentence" });
            return Array.from(segmenter.segment(paragraph), (segment) => segment.segment.trim()).filter(Boolean);
          }

          return paragraph
            .match(/[^.!?]+[.!?]+|[^.!?]+$/g)
            ?.map((sentence) => sentence.trim())
            .filter(Boolean) ?? [paragraph];
        }

        const paragraphSentenceGroups = sourceParagraphs.map((paragraph) => splitSentences(paragraph));

        const buildCandidate = (sentenceCount: number) => {
          let remaining = sentenceCount;
          const chunks = [];

          for (const paragraphSentences of paragraphSentenceGroups) {
            if (remaining <= 0) {
              break;
            }

            const take = Math.min(remaining, paragraphSentences.length);
            if (take > 0) {
              chunks.push(paragraphSentences.slice(0, take).join(" "));
              remaining -= take;
            }

            if (remaining > 0 && take === paragraphSentences.length) {
              chunks.push("\n\n");
            } else {
              break;
            }
          }

          return chunks.join("");
        };

        const fitExcerpt = () => {
          const excerptBox = excerpt.parentElement;

          if (!(excerptBox instanceof HTMLElement)) {
            return;
          }

          const maxWidth = excerptBox.clientWidth;
          const maxHeight = excerptBox.clientHeight;

          if (maxWidth <= 0 || maxHeight <= 0) {
            return;
          }

          const style = getComputedStyle(excerpt);
          const fontSize = Number.parseFloat(style.fontSize);
          const lineHeight = Number.parseFloat(style.lineHeight);
          const resolvedLineHeight = Number.isFinite(lineHeight) && lineHeight > 0
            ? lineHeight
            : Math.round(fontSize * 1.5);
          const font = `${style.fontStyle} ${style.fontVariant} ${style.fontWeight} ${style.fontSize} ${style.fontFamily}`
            .replace(/\s+/g, " ")
            .trim();
          const cache = new Map();

          const fits = (sentenceCount: number) => {
            const cached = cache.get(sentenceCount);

            if (cached !== undefined) {
              return cached <= maxHeight;
            }

            const candidate = buildCandidate(sentenceCount);
            const prepared = prepare(candidate, font, { whiteSpace: "pre-wrap" });
            const measured = layout(prepared, maxWidth, resolvedLineHeight).height;
            cache.set(sentenceCount, measured);
            return measured <= maxHeight;
          };

          let lo = 1;
          let hi = paragraphSentenceGroups.reduce((total, paragraphSentences) => total + paragraphSentences.length, 0);
          let best = 0;

          while (lo <= hi) {
            const mid = Math.floor((lo + hi) / 2);

            if (fits(mid)) {
              best = mid;
              lo = mid + 1;
            } else {
              hi = mid - 1;
            }
          }

          excerpt.textContent = buildCandidate(best);
        };

        const scheduleFit = () => {
          window.cancelAnimationFrame(frame);
          frame = window.requestAnimationFrame(fitExcerpt);
        };

        scheduleFit();

        window.addEventListener("resize", scheduleFit);

        if (document.fonts) {
          void document.fonts.ready.then(scheduleFit);
        }
      }
    }
  </script>
</BaseLayout>
