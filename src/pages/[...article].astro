---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPosts, getSiteConfig } from "../lib/content";
import { cmsEnabled } from "#content-source";
import { getMarkdownColumnArticles, MARKDOWN_COLUMNS } from "../lib/indigest";
import SlackMention from "../components/SlackMention.astro";
import SlackMrkdwnBody from "../components/SlackMrkdwnBody.astro";
import StoryPage from "../components/StoryPage.astro";
import SubmitFollowUp from "../components/SubmitFollowUp.astro";

// Articles published from Slack into the markdown columns. Markdown posts are
// prerendered by [...slug].astro, which Astro tries first, so only paths it
// does not know reach this page.
export const prerender = false;

const path = `/${Astro.params.article ?? ""}/`;
// With CMS=emdash no post is prerendered, so CMS posts reach this page too.
const cmsPost = cmsEnabled
  ? (await getPosts({ includeProtected: true })).find((post) => post.url === path)
  : undefined;
if (cmsPost?.membersOnly) {
  if (!Astro.locals.user) {
    return Astro.redirect(`/auth/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
  }
  // A protected article must never land in a shared cache.
  Astro.response.headers.set("Cache-Control", "private, no-store");
}
// Every unmatched path lands here, so only ones shaped like an article
// (/<markdown column>/<slug>/) are worth asking Indigest about.
const segments = (Astro.params.article ?? "").split("/").filter(Boolean);
const found =
  !cmsPost && segments.length === 2 && MARKDOWN_COLUMNS.includes(segments[0]!)
    ? (await getMarkdownColumnArticles(true)).find(
        ({ article }) => article.url === path,
      )
    : undefined;

if (!cmsPost && !found) {
  Astro.response.headers.set("Cache-Control", "no-store");
  return Astro.rewrite("/404");
}

if (found) {
  if (found.integration.authRequired && !Astro.locals.user) {
    return Astro.redirect(`/auth/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
  }

  // A protected article must never land in a shared cache.
  Astro.response.headers.set(
    "Cache-Control",
    found.integration.authRequired
      ? "private, no-store"
      : "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800",
  );
}

const site = await getSiteConfig();

// An author given as a Slack ID (bare or as <@ID>) renders as a mention, like
// the poster does when no author is given.
const authorId = found?.article.author?.match(/^<?@?([UW][A-Z0-9]+)(?:\|[^>]*)?>?$/)?.[1];
---

{cmsPost && <StoryPage slug={cmsPost.slug} />}

{
  found && (
    <BaseLayout
      title={found.article.title}
      siteTitle={site.title}
      siteDescription={site.description}
      canonicalPath={found.article.url}
    >
      <article class="story-page slack-story-page">
        <header class="story-header">
          <h1 class="story-title">{found.article.title}</h1>
          <div class="story-meta">
            <span class="story-category">
              <a class="page-link" href={`/${found.article.column}/`}>{found.article.column.toUpperCase()}</a>
            </span>
            <span class="story-author">
              By {authorId
                ? <SlackMention name="" id={authorId} />
                : found.article.author ?? <SlackMention name={found.message.userName || found.message.userId} id={found.message.userId} />}
            </span>
            {!Number.isNaN(found.article.date.getTime()) && (
              <>
                {" — "}
                <time datetime={found.article.date.toISOString()}>
                  {found.article.hasTime
                    ? found.article.date.toLocaleString("en-US", { dateStyle: "long", timeStyle: "short" })
                    : found.article.date.toLocaleDateString("en-US", { dateStyle: "long" })}
                </time>
              </>
            )}
          </div>
          <hr class="story-rule" />
        </header>

        <div class="story-body">
          <SlackMrkdwnBody text={found.message.formattedText || found.message.text} />
        </div>

        <SubmitFollowUp />

        <footer class="story-footer">
          <a href="/">&larr; Back to front page</a>
        </footer>
      </article>
    </BaseLayout>
  )
}
