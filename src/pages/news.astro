---
import BaseLayout from "../layouts/BaseLayout.astro";

import { getSiteConfig } from "../lib/content";
import ColumnFeedCard from "../components/ColumnFeedCard.astro";
import { getColumnFeedItems } from "../lib/column-feed";

export const prerender = false;


const site = await getSiteConfig();
const newsItems = await getColumnFeedItems("news", Boolean(Astro.locals.user));
---

<BaseLayout title="News Archive" siteTitle={site.title} siteDescription={site.description}>
  <div class="archive-page">
    <div class="section-label">NEWS</div>
    <hr class="section-rule" />
    <div class="archive-list">
      {newsItems.map((item) => (
        <ColumnFeedCard item={item} variant="story" />
      ))}
    </div>
  </div>
</BaseLayout>
