---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteConfig } from "../lib/content";

const site = await getSiteConfig();
---

<BaseLayout title="Search" siteTitle={site.title} siteDescription={site.description}>
  <div class="archive-page search-page">
    <div class="section-label">SEARCH</div>
    <hr class="section-rule" />

    <form class="search-form" role="search" action="/search/" method="get">
      <input
        type="search"
        id="search-input"
        name="q"
        class="search-input"
        placeholder="Search articles…"
        autocomplete="off"
        aria-label="Search articles"
      />
    </form>

    <p id="search-status" class="search-status" role="status" aria-live="polite"></p>

    <div id="search-results" class="archive-list"></div>

    <noscript>
      <p class="search-status">Search needs JavaScript enabled.</p>
    </noscript>
  </div>

  <script>
    import { tokenize, scoreDocument, type SearchDocument, type SearchIndex } from "../lib/search";
    import {
      bylineTransitionName,
      excerptTransitionName,
      readingTimeTransitionName,
      titleTransitionName,
    } from "../lib/transitions";

    // Bundled scripts run once per full page load, so re-run on every
    // client-side navigation to set up search on this page again.
    document.addEventListener("astro:page-load", () => {
      const input = document.getElementById("search-input") as HTMLInputElement | null;
      const results = document.getElementById("search-results");
      const status = document.getElementById("search-status");

      if (input && results && status) {
        let index: SearchIndex | null = null;
        let pending: string | null = null;

        const escapeHtml = (value: string) =>
          value.replace(/[&<>"']/g, (char) =>
            ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[char] as string)
          );

        const truncateWords = (text: string, count: number) => {
          const words = text.trim().split(/\s+/).filter(Boolean);
          return words.length <= count ? words.join(" ") : `${words.slice(0, count).join(" ")}…`;
        };

        const wordMatches = (word: string, terms: string[]) => {
          const cores = word.toLowerCase().match(/[a-z0-9]+/g);
          return Boolean(cores?.some((core) => terms.some((term) => core === term || core.startsWith(term))));
        };

        const highlightWord = (word: string, terms: string[]) =>
          wordMatches(word, terms) ? `<mark>${escapeHtml(word)}</mark>` : escapeHtml(word);

        const highlightText = (text: string, terms: string[]) =>
          text.split(/\s+/).filter(Boolean).map((word) => highlightWord(word, terms)).join(" ");

        const buildSnippet = (text: string, terms: string[]) => {
          const CONTEXT = 6;
          const MAX_WINDOWS = 3;
          const words = text.split(/\s+/).filter(Boolean);
          if (words.length === 0) return null;

          const windows: { start: number; end: number }[] = [];
          words.forEach((word, i) => {
            if (!wordMatches(word, terms)) return;
            const start = Math.max(0, i - CONTEXT);
            const end = Math.min(words.length - 1, i + CONTEXT);
            const last = windows[windows.length - 1];
            if (last && start <= last.end + 1) last.end = Math.max(last.end, end);
            else windows.push({ start, end });
          });

          if (windows.length === 0) return null;

          const chosen = windows.slice(0, MAX_WINDOWS);
          const segments = chosen.map((win) =>
            words.slice(win.start, win.end + 1).map((word) => highlightWord(word, terms)).join(" ")
          );

          let out = segments.join(" … ");
          if (chosen[0].start > 0) out = `… ${out}`;
          // Trailing ellipsis if the last shown window isn't the end, or hits were dropped.
          if (chosen[chosen.length - 1].end < words.length - 1 || windows.length > MAX_WINDOWS) out = `${out} …`;
          return out;
        };

        const parseQuery = (query: string) => {
          const authorMatch = query.match(/^@(\S+)/);
          if (authorMatch) {
            return { authorFilter: authorMatch[1], textQuery: query.slice(authorMatch[0].length).trim() };
          }
          return { authorFilter: null, textQuery: query };
        };

        // "by" and each author: Slack users as a mention chip with their
        // profile picture, everyone else as plain text.
        const bylineHtml = (doc: SearchDocument) => {
          const authors = doc.authors ?? [];
          if (authors.length === 0) return "";
          const names = authors.map((author) =>
            author.slackId
              ? `${author.avatar ? `<span class="byline-avatar"><img src="${escapeHtml(author.avatar)}" alt="" width="20" height="20" decoding="async" onerror="this.parentElement.remove()"></span>` : ""}<span class="slack_user">@${escapeHtml(author.name)}</span>`
              : escapeHtml(author.name),
          );
          const list =
            names.length === 1 ? names[0] : `${names.slice(0, -1).join(", ")} &amp; ${names[names.length - 1]}`;
          return `<span class="search-author" data-vt-byline="${bylineTransitionName(doc.url)}">by ${list}</span>`;
        };

        // Show the people and channels an excerpt mentions as chips, the way
        // the article does. Works on escaped HTML; a highlighted word is left
        // as it is.
        const chipsHtml = (html: string, doc: SearchDocument) => {
          const escapeRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
          const chip = (prefix: string, names: string[], className: string, current: string) =>
            [...new Set(names)]
              .filter(Boolean)
              .sort((a, b) => b.length - a.length)
              .reduce(
                (out, name) =>
                  out.replace(
                    new RegExp(`(^|[\\s(])${escapeRegExp(prefix + escapeHtml(name))}(?=$|[\\s.,;:!?)…])`, "g"),
                    `$1<span class="${className}">${prefix}${escapeHtml(name)}</span>`,
                  ),
                current,
              );
          return chip("#", doc.channels ?? [], "slack_channel", chip("@", doc.mentions ?? [], "slack_user", html));
        };

        const dateLabel = (date: string) =>
          date
            ? new Date(`${date}T12:00:00Z`).toLocaleDateString("en-US", {
                month: "long",
                day: "numeric",
                year: "numeric",
                timeZone: "UTC",
              })
            : "";

        const cardHtml = (doc: SearchDocument, titleHtml: string, previewHtml: string) => {
          const isSlack = doc.url.startsWith("/slack/");
          const categoryLabel = isSlack
            ? `<span class="slack-column-badge">${escapeHtml(doc.category)}</span>`
            : doc.category
              ? escapeHtml(doc.category)
              : "";
          const byline = bylineHtml(doc);
          const date = dateLabel(doc.date);
          return `
              <a href="${doc.url}" class="front-block story-block search-result">
                <header class="story-card-header">
                  <h3 class="story-block-title" data-vt-title="${titleTransitionName(doc.url)}">${titleHtml}</h3>
                  ${date ? `<time class="story-card-date" datetime="${doc.date}">${date}</time>` : ""}
                </header>
                <p class="story-block-excerpt" data-vt-excerpt="${excerptTransitionName(doc.url)}">${chipsHtml(previewHtml, doc)}</p>
                <span class="reading-time">${categoryLabel ? categoryLabel + " · " : ""}${byline ? byline + " · " : ""}<span class="search-reading-time" data-vt-reading-time="${readingTimeTransitionName(doc.url)}">${doc.readingTime} min read</span></span>
              </a>`;
        };

        const render = (query: string) => {
          if (!index) return;
          const { authorFilter, textQuery } = parseQuery(query);
          const terms = tokenize(textQuery);

          if (terms.length === 0 && !authorFilter) {
            const all = [...index.documents].sort((a, b) => {
              if (a.date && b.date) return b.date.localeCompare(a.date);
              return 0;
            });
            status.textContent = `${all.length} articles.`;
            results.innerHTML = all
              .map((doc) => cardHtml(doc, escapeHtml(doc.title), escapeHtml(truncateWords(doc.excerpt, 30))))
              .join("");
            return;
          }

          let ranked = index.documents
            .map((doc) => ({ doc, score: scoreDocument(doc, terms.length > 0 ? terms : [""], index!.weights) }))
            .filter((entry) => entry.score > 0);

          if (authorFilter) {
            const authorTerms = tokenize(authorFilter);
            ranked = ranked.filter((entry) => {
              const docAuthor = [entry.doc.author, ...(entry.doc.authors ?? []).map((author) => author.name)]
                .join(" ")
                .toLowerCase();
              return authorTerms.some((term) => docAuthor.includes(term));
            });
            // Boost author matches
            ranked = ranked.map((entry) => ({
              ...entry,
              score: entry.score + (entry.doc.author.toLowerCase().includes(authorFilter.toLowerCase()) ? 20 : 0),
            }));
          }

          ranked.sort((a, b) => b.score - a.score);

          if (ranked.length === 0) {
            results.innerHTML = "";
            status.textContent = `No results for "${query.trim()}".`;
            return;
          }

          status.textContent = `${ranked.length} result${ranked.length === 1 ? "" : "s"} for "${query.trim()}".`;
          results.innerHTML = ranked
            .map(({ doc }) =>
              cardHtml(
                doc,
                terms.length > 0 ? highlightText(doc.title, terms) : escapeHtml(doc.title),
                terms.length > 0
                  ? buildSnippet(doc.text, terms) ?? highlightText(truncateWords(doc.excerpt, 30), terms)
                  : escapeHtml(truncateWords(doc.excerpt, 30)),
              ),
            )
            .join("");
        };

        input.addEventListener("input", () => {
          if (index) render(input.value);
          else pending = input.value;
        });

        const initialQuery = new URLSearchParams(window.location.search).get("q");
        if (initialQuery) {
          input.value = initialQuery;
          pending = initialQuery;
        }
        status.textContent = "Loading index…";
        input.focus();

        fetch("/search-index.json")
          .then((response) => response.json())
          .then((data: SearchIndex) => {
            index = data;
            render(pending ?? input.value);
          })
          .catch(() => {
            status.textContent = "Could not load the search index.";
          });
      }
    });
  </script>

  <style>
    .search-form {
      margin-bottom: 16px;
    }

    .search-input {
      width: 100%;
      box-sizing: border-box;
      padding: 10px 12px;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1rem;
      color: #111;
      background: #fff;
      border: 1px solid #000;
      border-radius: 0;
    }

    .search-input:focus {
      outline: 2px solid #000;
      outline-offset: 1px;
    }

    .search-status {
      font-size: 0.78rem;
      font-family: Georgia, serif;
      letter-spacing: 0.04em;
      color: #555;
      margin: 0 0 16px;
      min-height: 1em;
    }

    .slack-column-badge {
      display: inline;
      font-weight: bold;
    }

    .search-author {
      color: #555;
    }
  </style>
</BaseLayout>
