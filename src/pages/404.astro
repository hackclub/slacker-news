---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteConfig } from "../lib/content";

const site = await getSiteConfig();
// The address the reader asked for (Astro.url is the 404 page itself).
const path = Astro.originPathname;
---

<BaseLayout title="404" siteTitle={site.title} siteDescription={site.description}>
  <section class="not-found">
    <div class="not-found-plate">
      <canvas class="not-found-canvas" aria-hidden="true"></canvas>
      <p class="not-found-fallback" aria-hidden="true">404</p>
    </div>

    <div class="not-found-copy">
      <h1 class="not-found-title">
        <span class="visually-hidden">404: </span>Stop the presses.
      </h1>
      <p class="not-found-lede">
        There's no story at <code>{path}</code>. It may have been spiked, moved
        to another page, or never filed at all.
      </p>
      <p class="not-found-links">
        <a href="/">Back to the front page</a>
        <span aria-hidden="true">·</span>
        <a href="/search/">Search the archive</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .not-found {
    margin: 32px 0 72px;
  }

  .not-found-plate {
    position: relative;
    height: clamp(220px, 42vw, 420px);
    touch-action: pan-y;
    cursor: crosshair;
  }

  .not-found-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  // Shown until the script draws the dots, and instead of them without
  // JavaScript.
  .not-found-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(140px, 30vw, 320px);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    color: #000;
  }

  .not-found-plate.is-drawn .not-found-fallback {
    visibility: hidden;
  }

  .not-found-copy {
    max-width: 34rem;
    margin: 8px auto 0;
    text-align: center;
  }

  .not-found-title {
    margin: 0 0 14px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    font-weight: 900;
    letter-spacing: -0.01em;
  }

  .not-found-lede {
    margin: 0 0 22px;
    font-size: 1.1rem;
    line-height: 1.6;
    color: #333;

    code {
      overflow-wrap: anywhere;
      font-size: 0.9em;
    }
  }

  .not-found-links {
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;

    a {
      color: #000;
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    span {
      margin: 0 10px;
      color: #999;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  import { mountHalftone } from "../lib/halftone";

  let stop: (() => void) | undefined;
  document.addEventListener("astro:page-load", () => {
    stop?.();
    stop = undefined;
    const plate = document.querySelector<HTMLElement>(".not-found-plate");
    if (plate) stop = mountHalftone(plate, "404");
  });
</script>
