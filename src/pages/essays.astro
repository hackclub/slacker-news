---
import BaseLayout from "../layouts/BaseLayout.astro";

import { getSiteConfig } from "../lib/content";
import ColumnFeedCard from "../components/ColumnFeedCard.astro";
import { getColumnFeedItems } from "../lib/column-feed";

export const prerender = false;


const site = await getSiteConfig();
const essaysItems = await getColumnFeedItems("essays", Boolean(Astro.locals.user));
---

<BaseLayout title="Essays Archive" siteTitle={site.title} siteDescription={site.description}>
  <div class="archive-page">
    <div class="section-label">ESSAYS</div>
    <hr class="section-rule" />
    <div class="archive-list">

      {essaysItems.map((item) => (
        <ColumnFeedCard item={item} variant="story" />
      ))}
    </div>
  </div>
</BaseLayout>
