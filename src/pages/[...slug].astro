---
import StoryPage from "../components/StoryPage.astro";
import { getPosts } from "../lib/content";
import { cmsEnabled } from "#content-source";

export const prerender = true;

export async function getStaticPaths() {
  // CMS posts can change after the build, so [...article].astro renders them
  // on demand instead.
  if (cmsEnabled) return [];
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { slug: post.slug },
  }));
}

const slugParam = Astro.props?.slug ?? Astro.params.slug;
const slug = Array.isArray(slugParam)
  ? slugParam.join("/")
  : typeof slugParam === "string"
    ? slugParam
    : "";

if (!slug) {
  throw new Error("Missing slug for story page");
}
---

<StoryPage slug={slug} />
